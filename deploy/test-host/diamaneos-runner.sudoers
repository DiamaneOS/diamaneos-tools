# Permit members of the protected evidence-review group to invoke only the
# fail-closed delegated wrapper as the non-login test runner. The wrapper fixes
# executable/configuration identities, constrains private paths and rejects
# development overrides before dispatch. This file deliberately grants no
# generic root command, shell, package, deployment, flashing or signing
# authority. Its only root routes are the two fixed maintenance actions below.

Runas_Alias DIAMANEOS_TEST_RUNNER = diamaneos-test

Cmnd_Alias DIAMANEOS_REVIEWED_RUNNER = \
    /opt/diamaneos/tools/deploy/test-host/diamaneos-delegated-runner *

Cmnd_Alias DIAMANEOS_MAINTENANCE_CONTROL = \
    /opt/diamaneos/tools/deploy/test-host/diamaneos-rig-maintenance-control enable, \
    /opt/diamaneos/tools/deploy/test-host/diamaneos-rig-maintenance-control disable-and-restore

%diamaneos-test ALL=(DIAMANEOS_TEST_RUNNER) NOPASSWD: \
    DIAMANEOS_REVIEWED_RUNNER

%diamaneos-test ALL=(root) NOPASSWD: DIAMANEOS_MAINTENANCE_CONTROL
