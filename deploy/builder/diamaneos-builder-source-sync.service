[Unit]
Description=DiamaneOS pinned Android source synchronization
Wants=network-online.target
After=network-online.target
ConditionPathIsSymbolicLink=/opt/diamaneos/tools

[Service]
Type=oneshot
User=diamaneos-build
Group=diamaneos-build
WorkingDirectory=/var/lib/diamaneos-build
Environment=HOME=/var/lib/diamaneos-build
Environment=COREPACK_HOME=/var/lib/diamaneos-build/.cache/corepack
Environment=PATH=/var/lib/diamaneos-build/toolbin:/usr/local/bin:/usr/bin:/bin
Environment=DIAMANEOS_TOOLS_ROOT=/opt/diamaneos/tools
EnvironmentFile=/etc/diamaneos/builder-source-sync.env
UMask=0027
ExecStart=/opt/diamaneos/tools/deploy/builder/sync-pinned-source /opt/diamaneos/tools /var/lib/diamaneos-build
TimeoutStartSec=infinity
Restart=no
RemainAfterExit=yes
StandardOutput=append:/var/log/diamaneos-builder/source-sync.log
StandardError=append:/var/log/diamaneos-builder/source-sync.log
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/diamaneos-build /var/log/diamaneos-builder
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=1048576
