[Unit]
Description=DiamaneOS builder USB-only ADB server for compatibility trials
Documentation=file:/opt/diamaneos/tools/docs/COMPATIBILITY.md
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
User=diamaneos-build
Group=diamaneos-build
Environment=HOME=/var/lib/diamaneos-build
Environment=ADB_MDNS=0
UMask=0027
ExecStart=/usr/local/bin/adb -L tcp:localhost:5037 nodaemon server
ExecStop=/usr/local/bin/adb kill-server
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/diamaneos-build
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
