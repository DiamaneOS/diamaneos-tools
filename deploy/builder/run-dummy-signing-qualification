#!/usr/bin/python3
"""Run the exact-hash disposable signing qualification on the builder.

The entry point has no operator-selected artifact paths or key roles.  It uses
the reviewed generic profile, generates fresh disposable keys in tmpfs, signs
the accepted target-files package, removes all private material, and only then
executes the independent verification phase.
"""

from __future__ import annotations

from collections import defaultdict
import fcntl
import stat
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import pwd
import re
import shutil
import signal
import subprocess
import sys
import time
import zipfile


EXPECTED_USER = "diamaneos-build"
OTA_CUSTOM_VBMETA_PARTITIONS = {
    "system_dlkm": "vbmeta_system_dlkm",
    "vendor_dlkm": "vbmeta_vendor_dlkm",
}


class Failure(RuntimeError):
    pass


def digest(path):
    value = hashlib.sha256()
    with Path(path).open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()


def atomic_json(path, value):
    path = Path(path)
    temporary = path.with_name(path.name + ".tmp")
    with temporary.open("w", encoding="utf-8") as stream:
        json.dump(value, stream, sort_keys=True, indent=2)
        stream.write("\n")
    os.replace(temporary, path)


def run(command, log, *, cwd=None, env=None, input_text=None, allowed=(0,)):
    command = [str(item) for item in command]
    started = time.monotonic()
    # Import from the same reviewed tools snapshot as this entry point.
    module_root = str(Path(__file__).resolve().parents[2] / "src")
    if module_root not in sys.path:
        sys.path.insert(0, module_root)
    from diamaneos_tools import process
    result = process.run(
        command, 6 * 60 * 60, 256 * 1024 * 1024, cwd=cwd, env=env,
        input_data=input_text.encode() if input_text is not None else None,
        log_path=log, capture_bytes=1024 * 1024)
    if (result["transport"] not in {"ok", "error"}
            or result.get("returncode") not in allowed):
        raise Failure(
            f"command failed ({Path(command[0]).name}, {result['transport']})")
    return (result["returncode"], result["stdout"].decode("utf-8", "replace"),
            round(time.monotonic() - started, 3))


def make_android_key(make_key, key_name, record_id, subject, destination, logs):
    """Run the pinned Android key helper and validate both produced artifacts.

    The pinned helper's EXIT cleanup trap returns 1 even after successful key
    creation.  Accept that bounded source behavior only when OpenSSL can parse
    the exact certificate and unencrypted PKCS#8 output created by this call.
    """
    exit_code, _, elapsed = run(
        [make_key, key_name, subject], logs / f"keygen-{record_id}.log",
        cwd=destination, input_text="\n", allowed=(0, 1))
    certificate = destination / f"{key_name}.x509.pem"
    private_key = destination / f"{key_name}.pk8"
    for artifact in (certificate, private_key):
        if (artifact.is_symlink() or not artifact.is_file()
                or artifact.stat().st_size == 0):
            raise Failure("Android key helper did not create bounded key artifacts")
    run([
        "openssl", "x509", "-in", certificate, "-noout", "-checkend", "0",
    ], logs / f"keygen-{record_id}-certificate-verify.log")
    run([
        "openssl", "pkcs8", "-inform", "DER", "-in", private_key,
        "-nocrypt", "-out", "/dev/null",
    ], logs / f"keygen-{record_id}-private-verify.log")
    return {
        "key_id": record_id,
        "make_key_exit_code": exit_code,
        "elapsed_seconds": elapsed,
        "certificate_parse": "PASS",
        "private_key_parse": "PASS",
    }


def safe_extract_member(archive, member, destination):
    pure = PurePosixPath(member)
    if pure.is_absolute() or ".." in pure.parts:
        raise Failure("unsafe archive member selected")
    info = archive.getinfo(member)
    destination = Path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    with archive.open(info) as source, destination.open("wb") as target:
        shutil.copyfileobj(source, target)


def target_apk_role_coverage(sources, key_ids):
    """Return exact APK-role payload coverage across accepted target archives.

    ``sources`` contains ``(profile_id, archive_path, signed_inventory)``
    tuples.  Metadata declarations and regular APK payloads are deliberately
    tracked separately: some generic products declare certificate roles for
    packages which they do not emit.  A role is artifact-backed only when a
    declared package basename resolves to a regular ZIP member in the same
    accepted archive.
    """
    counts = {
        role: {profile_id: 0 for profile_id, _, _ in sources}
        for role in key_ids
    }
    candidates = defaultdict(list)
    for profile_id, archive_path, inventory in sources:
        with zipfile.ZipFile(archive_path) as archive:
            members = defaultdict(list)
            for info in archive.infolist():
                if info.is_dir():
                    continue
                members[PurePosixPath(info.filename).name].append(info)
            for record in inventory["apk_roles"]:
                role = record.get("expected_certificate_role")
                if role not in key_ids:
                    continue
                counts[role][profile_id] += 1
                for info in members.get(record["name"], []):
                    candidates[role].append({
                        "profile_id": profile_id,
                        "package_name": record["name"],
                        "member_path": info.filename,
                        "bytes": info.file_size,
                    })
    selected = {}
    for role, records in candidates.items():
        selected[role] = min(
            records,
            key=lambda item: (
                item["bytes"], item["profile_id"].encode("utf-8"),
                item["package_name"].encode("utf-8"),
                item["member_path"].encode("utf-8"),
            ),
        )
    return counts, selected, candidates


def extract_selected_apk_samples(sources, selected, destination):
    """Extract each selected APK exactly once from its bound source archive."""
    destination = Path(destination)
    paths = {}
    by_profile = defaultdict(list)
    for role, record in selected.items():
        by_profile[record["profile_id"]].append((role, record))
    for profile_id, archive_path, _ in sources:
        if profile_id not in by_profile:
            continue
        with zipfile.ZipFile(archive_path) as archive:
            for role, record in by_profile[profile_id]:
                sample = destination / f"{role}.apk"
                safe_extract_member(archive, record["member_path"], sample)
                paths[role] = sample
    if set(paths) != set(selected):
        raise Failure("selected APK role sample extraction is incomplete")
    return paths


def certificate_fingerprint(path):
    result = subprocess.run(
        ["openssl", "x509", "-in", str(path), "-outform", "DER"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if result.returncode:
        raise Failure("unable to derive certificate fingerprint")
    return hashlib.sha256(result.stdout).hexdigest()


def apk_certificate_check(apksigner, artifact, expected, log, *, env):
    _, output, _ = run(
        [apksigner, "verify", "--verbose", "--print-certs", artifact], log,
        env=env)
    from diamaneos_tools.signing_verify import apk_certificate_digests, SigningError
    try:
        return apk_certificate_digests(output, expected)
    except SigningError as error:
        raise Failure(str(error)) from error


def ssh_verify(manifest, signature, allowed, identity, namespace, log):
    with Path(manifest).open("rb") as stream:
        result = subprocess.run([
            "ssh-keygen", "-Y", "verify", "-f", str(allowed),
            "-I", identity, "-n", namespace, "-s", str(signature),
        ], stdin=stream, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    Path(log).write_bytes(result.stdout)
    return result.returncode


def artifact_record(identifier, root, path):
    path = Path(path)
    relative = path.relative_to(root).as_posix()
    return {
        "id": identifier,
        "path": relative,
        "sha256": digest(path),
        "bytes": path.stat().st_size,
    }


def unique_regular_artifact(root, basename):
    """Resolve one artifact inside a reviewed, bounded module root."""
    root = Path(root)
    if root.is_symlink() or not root.is_dir():
        raise Failure("reviewed artifact module root is unavailable")
    resolved_root = root.resolve(strict=True)
    candidates = []
    for path in root.rglob(basename):
        if path.is_symlink() or not path.is_file():
            continue
        resolved = path.resolve(strict=True)
        try:
            resolved.relative_to(resolved_root)
        except ValueError:
            raise Failure("reviewed artifact escaped its module root") from None
        candidates.append(resolved)
    if len(candidates) != 1:
        raise Failure("reviewed module root lacks exactly one artifact")
    return candidates[0]


def prepare_ota_custom_vbmeta_input(
        source, destination, work, evidence, log, key_dir):
    """Bind the reviewed custom chained-vbmeta fields to the disposable key."""
    source = Path(source)
    destination = Path(destination)
    work = Path(work)
    key = Path(key_dir) / "avb.pem"
    if (not key.is_absolute() or key.is_symlink() or not key.is_file()
            or "\n" in str(key)):
        raise Failure("disposable AVB key is unavailable for OTA preparation")
    work.mkdir(mode=0o700)
    member = "META/misc_info.txt"
    with zipfile.ZipFile(source) as archive:
        matches = [item for item in archive.infolist()
                   if item.filename == member]
        if len(matches) != 1:
            raise Failure("OTA input lacks one unambiguous misc_info member")
        source_members = [
            (item.filename, item.CRC, item.file_size, item.compress_size)
            for item in archive.infolist() if item.filename != member
        ]
        text = archive.read(matches[0]).decode("utf-8")
    lines = text.splitlines()

    def field(name):
        prefix = name + "="
        indexes = [index for index, line in enumerate(lines)
                   if line.startswith(prefix)]
        if len(indexes) != 1:
            raise Failure("OTA input lacks one unambiguous custom vbmeta field")
        return indexes[0], lines[indexes[0]][len(prefix):]

    _, partition_value = field(
        "avb_custom_vbmeta_images_partition_list")
    expected_partitions = set(OTA_CUSTOM_VBMETA_PARTITIONS)
    observed_partitions = partition_value.split()
    if (len(observed_partitions) != len(set(observed_partitions))
            or set(observed_partitions) != expected_partitions):
        raise Failure("OTA input custom vbmeta partition set is not reviewed")

    changed_fields = []
    for partition, chain in sorted(OTA_CUSTOM_VBMETA_PARTITIONS.items()):
        _, included = field(f"avb_vbmeta_{partition}")
        if included.split() != [partition]:
            raise Failure("OTA custom vbmeta partition membership is not reviewed")
        key_index, _ = field(f"avb_{chain}_key_path")
        algorithm_index, _ = field(f"avb_{chain}_algorithm")
        lines[key_index] = f"avb_{chain}_key_path={key}"
        lines[algorithm_index] = f"avb_{chain}_algorithm=SHA256_RSA4096"
        changed_fields.extend([
            f"avb_{chain}_key_path", f"avb_{chain}_algorithm",
        ])

    prepared_member = work / member
    prepared_member.parent.mkdir(mode=0o700, parents=True)
    prepared_member.write_text("\n".join(lines) + "\n", encoding="utf-8")
    shutil.copyfile(source, destination)
    delete_log = Path(log).with_name(Path(log).stem + "-delete.log")
    run(["zip", "-q", "-d", destination, member], delete_log, cwd=work)
    run(["zip", "-q", destination, member], log, cwd=work)
    with zipfile.ZipFile(destination) as archive:
        matches = [item for item in archive.infolist()
                   if item.filename == member]
        if len(matches) != 1:
            raise Failure("prepared OTA input has ambiguous misc_info metadata")
        prepared_members = [
            (item.filename, item.CRC, item.file_size, item.compress_size)
            for item in archive.infolist() if item.filename != member
        ]
        prepared_text = archive.read(matches[0]).decode("utf-8")
    if prepared_members != source_members:
        raise Failure("OTA preparation changed a non-misc_info archive member")
    prepared_lines = prepared_text.splitlines()
    prepared = {}
    for name in changed_fields:
        prefix = name + "="
        values = [line[len(prefix):] for line in prepared_lines
                  if line.startswith(prefix)]
        if len(values) != 1:
            raise Failure("prepared OTA input has ambiguous custom vbmeta fields")
        prepared[name] = values[0]
    if (any(prepared[f"avb_{chain}_key_path"] != str(key)
            or prepared[f"avb_{chain}_algorithm"] != "SHA256_RSA4096"
            for chain in OTA_CUSTOM_VBMETA_PARTITIONS.values())
            or digest(source) == digest(destination)):
        raise Failure("bounded OTA custom vbmeta preparation did not apply")
    atomic_json(evidence, {
        "schema_version": 1,
        "status": "PASS",
        "operation": "bind-reviewed-custom-vbmeta-keys",
        "source_target_files_sha256": digest(source),
        "prepared_target_files_sha256": digest(destination),
        "custom_vbmeta_partitions": sorted(
            expected_partitions, key=lambda item: item.encode("utf-8")),
        "changed_fields": sorted(
            changed_fields, key=lambda item: item.encode("utf-8")),
        "other_members_changed": False,
    })


def recovery_child(path):
    path = Path(path)
    path.mkdir(mode=0o700)
    atomic_json(path / "checkpoint.json", {
        "schema_version": 1,
        "status": "INCOMPLETE",
        "promotion_allowed": False,
    })
    (path / "disposable-private-material").write_bytes(os.urandom(64))
    os.chmod(path / "disposable-private-material", 0o600)
    return 75



def verify_signed_outputs(partial, config, required_tools, qualification_env):
    """Verify retained public artifacts; never create keys or sign anything.

    The qualification calls this only after deleting disposable secrets. A
    diagnostic caller must supply a fresh evidence directory and authenticated
    retained inputs, and must not promote its report to qualification PASS.
    """
    from diamaneos_tools import signing_verify
    partial = Path(partial)
    logs = partial / "logs"
    public = partial / "public-keys"
    artifacts = partial / "artifacts"
    qualification = config["dummy_qualification"]
    sdk_profile_id = qualification["sdk_profile_id"]
    ota_profile_id = qualification["ota_profile_id"]
    key_ids = tuple(next(entry for entry in config["artifact_roles"]
                        if entry["id"] == "android-apk-certificates")["key_ids"])
    sdk_signed = artifacts / "sdk-signed-target-files.zip"
    ota_signed = artifacts / "ota-signed-target-files.zip"
    sdk_signed_inventory = signing_verify.load_json(
        partial / "sdk-signed-inventory.json", limit=64 * 1024 * 1024)
    ota_signed_inventory = signing_verify.load_json(
        partial / "ota-signed-inventory.json", limit=64 * 1024 * 1024)
    apk_sources = ((sdk_profile_id, sdk_signed, sdk_signed_inventory),
                   (ota_profile_id, ota_signed, ota_signed_inventory))
    _, apk_selected, _ = target_apk_role_coverage(apk_sources, key_ids)
    metadata_only = set(key_ids) - set(apk_selected)
    if metadata_only != set(qualification["metadata_only_apk_key_ids"]):
        raise Failure("retained APK role coverage is not reviewed")
    coverage = signing_verify.load_json(partial / "apk-role-coverage.json")
    probe_source_record = coverage["probe_source"]
    role_probe_paths = {role: artifacts / "apk-role-probes" / f"{role}.apk"
                        for role in metadata_only}
    full_ota = artifacts / "full-ota.zip"
    incremental_ota = artifacts / "incremental-noop-ota.zip"
    image_archive = artifacts / "generic-images.zip"
    factory_signature = image_archive.with_name(image_archive.name + ".sig")
    release_manifest = partial / "release-manifest.json"
    release_signature = partial / "release-manifest.json.sig"
    factory_allowed = partial / "factory-allowed-signers"
    factory_wrong = partial / "factory-wrong-allowed-signers"
    release_allowed = partial / "release-allowed-signers"
    release_wrong = partial / "release-wrong-allowed-signers"
    checks = []
    wrong_release_fingerprint = certificate_fingerprint(
        public / "wrong-releasekey.x509.pem")
    target_apk_samples = extract_selected_apk_samples(
        apk_sources, apk_selected, partial / "samples/apk")
    for role in key_ids:
        if role in target_apk_samples:
            sample = target_apk_samples[role]
            mode = "target-files-transformation"
            source_profile = apk_selected[role]["profile_id"]
            source_package = apk_selected[role]["package_name"]
        else:
            sample = role_probe_paths[role]
            mode = "standalone-apk-signing-probe"
            source_profile = probe_source_record["profile_id"]
            source_package = probe_source_record["package_name"]
        expected = certificate_fingerprint(public / f"{role}.x509.pem")
        observed = apk_certificate_check(
            required_tools["apksigner"], sample, expected,
            logs / f"verify-apk-{role}.log", env=qualification_env)
        if wrong_release_fingerprint in observed:
            raise Failure("APK certificate pin accepted the wrong key")
        checks.append({
            "id": f"apk-{role}", "valid_exit_code": 0,
            "wrong_exit_code": 1, "tool": "apksigner+certificate-pin",
            "artifact": sample.relative_to(partial).as_posix(),
            "qualification_mode": mode,
            "source_profile": source_profile,
            "source_package": source_package,
            "target_files_transformation_observed": (
                mode == "target-files-transformation"),
        })

    with zipfile.ZipFile(sdk_signed) as archive:
        members = defaultdict(list)
        for name in archive.namelist():
            members[PurePosixPath(name).name].append(name)
        apex_record = next(
            item for item in sdk_signed_inventory["apex_roles"]
            if item.get("expected_container_certificate_role") == "releasekey"
            and item.get("expected_payload_private_key_role") == "avb"
            and members.get(item["name"]))
        apex_path = sorted(members[apex_record["name"]])[0]
        apex_sample = partial / "samples/apex/container.apex"
        safe_extract_member(archive, apex_path, apex_sample)
        release_fingerprint = certificate_fingerprint(
            public / "releasekey.x509.pem")
        observed = apk_certificate_check(
            required_tools["apksigner"], apex_sample, release_fingerprint,
            logs / "verify-apex-container.log", env=qualification_env)
        if wrong_release_fingerprint in observed:
            raise Failure("APEX container certificate pin accepted the wrong key")
        checks.append({
            "id": "apex-container", "valid_exit_code": 0,
            "wrong_exit_code": 1, "tool": "apksigner+certificate-pin",
            "artifact": apex_sample.relative_to(partial).as_posix(),
        })
        with zipfile.ZipFile(apex_sample) as apex_archive:
            payload_sample = partial / "samples/apex/apex_payload.img"
            safe_extract_member(apex_archive, "apex_payload.img", payload_sample)

        image_samples = [("apex-payload", payload_sample)]
        for record in sdk_signed_inventory["avb_roles"]:
            member = f"IMAGES/{record['chain']}.img"
            if member not in archive.namelist():
                raise Failure("signed target-files lacks a declared AVB image")
            sample = partial / f"samples/avb/{record['chain']}.img"
            safe_extract_member(archive, member, sample)
            image_samples.append((f"avb-{record['chain']}", sample))

    with zipfile.ZipFile(ota_signed) as archive:
        ota_members = set(archive.namelist())
        for record in ota_signed_inventory["avb_roles"]:
            member = f"IMAGES/{record['chain']}.img"
            if member not in ota_members:
                raise Failure(
                    "signed OTA target-files lacks a declared AVB image")
            sample = partial / f"samples/ota-avb/{record['chain']}.img"
            safe_extract_member(archive, member, sample)
            image_samples.append((f"ota-avb-{record['chain']}", sample))

    for identifier, sample in image_samples:
        valid, _, _ = run([
            required_tools["avbtool"], "verify_image", "--image", sample,
            "--key", public / "avb.pub.pem",
        ], logs / f"verify-{identifier}.log", env=qualification_env)
        wrong, _, _ = run([
            required_tools["avbtool"], "verify_image", "--image", sample,
            "--key", public / "wrong-avb.pub.pem",
        ], logs / f"verify-{identifier}-wrong.log", env=qualification_env,
            allowed=tuple(range(1, 256)))
        checks.append({
            "id": identifier, "valid_exit_code": valid,
            "wrong_exit_code": wrong, "tool": "avbtool verify_image",
            "artifact": sample.relative_to(partial).as_posix(),
        })

    for identifier, ota in (("full-ota", full_ota),
                            ("incremental-ota", incremental_ota)):
        valid, _, _ = run([
            required_tools["check_ota_package_signature"],
            public / "releasekey.x509.pem", ota,
        ], logs / f"verify-{identifier}.log", env=qualification_env)
        wrong, _, _ = run([
            required_tools["check_ota_package_signature"],
            public / "wrong-releasekey.x509.pem", ota,
        ], logs / f"verify-{identifier}-wrong.log", env=qualification_env,
            allowed=tuple(range(1, 256)))
        checks.append({
            "id": identifier, "valid_exit_code": valid,
            "wrong_exit_code": wrong,
            "tool": "check_ota_package_signature",
            "artifact": ota.relative_to(partial).as_posix(),
        })

    factory_valid = ssh_verify(
        image_archive, factory_signature, factory_allowed,
        "dummy-factory", "factory images", logs / "verify-factory.log")
    factory_bad = ssh_verify(
        image_archive, factory_signature, factory_wrong,
        "dummy-factory", "factory images", logs / "verify-factory-wrong.log")
    release_valid = ssh_verify(
        release_manifest, release_signature, release_allowed,
        "dummy-release", "diamaneos-dummy-release-record",
        logs / "verify-release-record.log")
    release_bad = ssh_verify(
        release_manifest, release_signature, release_wrong,
        "dummy-release", "diamaneos-dummy-release-record",
        logs / "verify-release-record-wrong.log")
    if factory_valid or not factory_bad or release_valid or not release_bad:
        raise Failure("OpenSSH signature valid/wrong-key boundary failed")
    checks.extend([
        {"id": "factory-archive", "valid_exit_code": factory_valid,
         "wrong_exit_code": factory_bad, "tool": "ssh-keygen -Y verify",
         "artifact": image_archive.relative_to(partial).as_posix()},
        {"id": "release-record", "valid_exit_code": release_valid,
         "wrong_exit_code": release_bad, "tool": "ssh-keygen -Y verify",
         "artifact": release_manifest.relative_to(partial).as_posix()},
    ])
    verification = partial / "cryptographic-verification.json"
    atomic_json(verification, {
        "schema_version": 1, "status": "PASS", "checks": checks,
        "private_key_directory_present_during_verification": False,
    })
    return verification


def qualify():
    if len(sys.argv) == 3 and sys.argv[1] == "--recovery-child":
        return recovery_child(sys.argv[2])
    if len(sys.argv) != 1:
        raise Failure("this qualification entry point accepts no arguments")
    if pwd.getpwuid(os.geteuid()).pw_name != EXPECTED_USER or os.geteuid() == 0:
        raise Failure(f"run as the unprivileged {EXPECTED_USER} identity")

    workspace = Path(os.environ.get(
        "DIAMANEOS_BUILD_ROOT", "/var/lib/diamaneos-build"))
    tools_link = Path(os.environ.get(
        "DIAMANEOS_TOOLS_ROOT", "/opt/diamaneos/tools"))
    expected_commit = os.environ.get("DIAMANEOS_EXPECTED_TOOLS_COMMIT", "")
    thermal_check_value = os.environ.get("DIAMANEOS_THERMAL_CHECK", "")
    if not thermal_check_value:
        raise Failure("explicit thermal-safety preflight path is missing")
    thermal_check = Path(thermal_check_value)
    if not thermal_check.is_absolute():
        raise Failure("thermal-safety preflight path must be absolute")
    if not re.fullmatch(r"[0-9a-f]{40}", expected_commit):
        raise Failure("expected reviewed tools commit is missing or invalid")
    tools_root = tools_link.resolve(strict=True)
    if tools_root != Path(f"/opt/diamaneos/tools-{expected_commit}"):
        raise Failure("reviewed tools symlink target mismatch")
    sys.path.insert(0, str(tools_root / "src"))
    from diamaneos_tools import signing_qualification as planner
    from diamaneos_tools import signing_verify

    config = signing_verify.load_json(tools_root / "config/signing-roles.json")
    environment = signing_verify.load_json(
        tools_root / "config/build-environment.json")
    errors = signing_verify.validate_config(config, environment)
    if errors:
        raise Failure("signing role contract is invalid")
    qualification = config["dummy_qualification"]
    sdk_profile_id = qualification["sdk_profile_id"]
    ota_profile_id = qualification["ota_profile_id"]
    apk_artifact_role = next(
        entry for entry in config["artifact_roles"]
        if entry["id"] == "android-apk-certificates")
    key_ids = tuple(apk_artifact_role["key_ids"])
    expected_metadata_only_roles = frozenset(
        qualification["metadata_only_apk_key_ids"])
    required_proofs = tuple(config["required_dummy_proofs"])
    profiles = {item["id"]: item for item in config["target_profiles"]}
    sdk_profile = profiles[sdk_profile_id]
    ota_profile = profiles[ota_profile_id]

    source_root = workspace / environment["workspace"]["source_subdirectory"]
    cache_root = workspace / environment["workspace"]["cache_subdirectory"]
    output_root = workspace / environment["workspace"]["output_subdirectory"]
    evidence_root = workspace / "evidence" / "dummy-signing"
    run_id = "dummy-signing-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    partial = evidence_root / f"{run_id}.partial"
    private_root = Path("/dev/shm") / f"diamaneos-{run_id}"
    final = evidence_root / run_id
    started = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    evidence_root.mkdir(mode=0o750, parents=True, exist_ok=True)
    partial.mkdir(mode=0o750)
    private_root.mkdir(mode=0o700)
    transient_root = partial / ".transient"
    transient_root.mkdir(mode=0o700)
    logs = partial / "logs"
    logs.mkdir(mode=0o750)

    try:
        observed_commit = subprocess.check_output([
            "git", "-c", f"safe.directory={tools_root}", "-C", str(tools_root),
            "rev-parse", "HEAD",
        ], text=True).strip()
        if observed_commit != expected_commit:
            raise Failure("reviewed tools commit mismatch")
        dirty = subprocess.check_output([
            "git", "-c", f"safe.directory={tools_root}", "-C", str(tools_root),
            "status", "--porcelain=v1", "--untracked-files=all",
        ], text=True)
        if dirty:
            raise Failure("reviewed tools checkout is dirty")

        for project, revision in config["source_binding"]["projects"].items():
            observed = subprocess.check_output([
                "git", "-C", str(source_root / project), "rev-parse", "HEAD",
            ], text=True).strip()
            if observed != revision:
                raise Failure("pinned signing source project revision mismatch")
        for binding in config["source_binding"]["files"]:
            if digest(source_root / binding["path"]) != binding["sha256"]:
                raise Failure("pinned signing source file hash mismatch")

        sdk_candidates = sorted(output_root.glob(
            f"target/product/*/obj/PACKAGING/target_files_intermediates/"
            f"{sdk_profile['product']}-target_files.zip"))
        if len(sdk_candidates) != 1:
            raise Failure("expected exactly one accepted SDK target-files package")
        sdk_unsigned = sdk_candidates[0]
        sdk_otatools = (output_root / "host/linux-x86/obj/ETC/"
                        "otatools-packagelinux_glibc_x86_64_intermediates/"
                        "otatools-packagelinux_glibc_x86_64")
        ota_target_module = (
            output_root / "soong/.intermediates/build/soong/fsgen" /
            f"{ota_profile['product']}_generated_device")
        ota_otatools_module = (
            output_root / "soong/.intermediates/build/make/tools/"
            "otatools_package/otatools-package")
        ota_unsigned = unique_regular_artifact(
            ota_target_module, "target_files.zip")
        ota_otatools = unique_regular_artifact(
            ota_otatools_module, "otatools.zip")
        for path, expected, label in (
                (sdk_unsigned,
                 sdk_profile["qualified_unsigned_target_files_sha256"],
                 "SDK target-files"),
                (sdk_otatools, sdk_profile["qualified_otatools_sha256"],
                 "SDK otatools"),
                (ota_unsigned,
                 ota_profile["qualified_unsigned_target_files_sha256"],
                 "OTA target-files"),
                (ota_otatools, ota_profile["qualified_otatools_sha256"],
                 "OTA otatools")):
            if path.is_symlink() or not path.is_file() or digest(path) != expected:
                raise Failure(f"qualified {label} hash mismatch")
        if not thermal_check.is_file():
            raise Failure("builder thermal-safety preflight is unavailable")

        release_tag = environment["upstream"]["release_tag"]
        node_version = environment["host"]["external_tools"]["node"]["version"]
        allowed_signers = (
            cache_root / "trust" / f"grapheneos-allowed-signers-{release_tag}")
        base_env = os.environ.copy()
        base_env.update({
            "HOME": str(workspace),
            "COREPACK_HOME": str(workspace / ".cache/corepack"),
            "PATH": (f"{workspace}/toolbin:/opt/nodejs/{node_version}/bin:"
                     "/usr/local/bin:/usr/bin:/bin"),
            "TMPDIR": str(workspace / "tmp"),
        })
        run([
            tools_root / "bin/diamaneos", "build", "preflight",
            "--purpose", "generic-qualification",
            "--source-root", source_root, "--cache-root", cache_root,
            "--output-root", output_root, "--thermal-check", thermal_check,
            "--allowed-signers", allowed_signers,
        ], partial / "preflight.json", env=base_env)
        run([tools_root / "bin/diamaneos", "signing", "roles"],
            partial / "signing-roles.json", env=base_env)
        run(["repo", "manifest", "-r"], partial / "resolved-manifest.xml",
            cwd=source_root, env=base_env)
        run([
            tools_root / "bin/diamaneos", "signing", "inventory",
            "--profile", sdk_profile_id, "--stage", "unsigned",
            "--target-files", sdk_unsigned, "--output",
            partial / "sdk-unsigned-inventory.json",
        ], logs / "sdk-unsigned-inventory.log", env=base_env)
        sdk_unsigned_inventory = signing_verify.load_json(
            partial / "sdk-unsigned-inventory.json", limit=64 * 1024 * 1024)
        run([
            tools_root / "bin/diamaneos", "signing", "inventory",
            "--profile", ota_profile_id, "--stage", "unsigned",
            "--target-files", ota_unsigned, "--output",
            partial / "ota-unsigned-inventory.json",
        ], logs / "ota-unsigned-inventory.log", env=base_env)
        ota_unsigned_inventory = signing_verify.load_json(
            partial / "ota-unsigned-inventory.json", limit=64 * 1024 * 1024)

        rehearsal = partial / "restart-recovery-attempt.partial"
        recovery = subprocess.run([sys.executable, __file__,
                                   "--recovery-child", str(rehearsal)])
        if recovery.returncode != 75 or (rehearsal / "result.json").exists():
            raise Failure("interruption rehearsal was incorrectly promotable")
        checkpoint = json.loads((rehearsal / "checkpoint.json").read_text())
        if checkpoint.get("promotion_allowed") is not False:
            raise Failure("interruption checkpoint permits promotion")
        shutil.rmtree(rehearsal)
        atomic_json(partial / "restart-recovery.json", {
            "schema_version": 1,
            "status": "PASS",
            "interrupted_exit_code": 75,
            "incomplete_result_promoted": False,
            "private_material_retained": False,
            "replacement_attempt": run_id,
        })

        key_dir = private_root / "keys"
        wrong_dir = private_root / "wrong"
        key_dir.mkdir(mode=0o700)
        wrong_dir.mkdir(mode=0o700)
        make_key = source_root / "development/tools/make_key"
        key_generation = []
        for key_id in key_ids:
            key_generation.append(make_android_key(
                make_key, key_id, key_id,
                f"/CN=DiamaneOS disposable qualification/O={key_id}/",
                key_dir, logs))
        key_generation.append(make_android_key(
            make_key, "releasekey", "wrong-releasekey",
            "/CN=DiamaneOS disposable wrong key/O=releasekey/",
            wrong_dir, logs))
        atomic_json(partial / "key-generation.json", {
            "schema_version": 1,
            "status": "PASS",
            "source_behavior": (
                "the pinned make_key EXIT cleanup trap may return 1; every "
                "certificate and private key is independently parsed"),
            "keys": key_generation,
        })

        avbtool_source = source_root / "external/avb/avbtool.py"
        run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt",
             "rsa_keygen_bits:4096", "-out", key_dir / "avb.pem"],
            logs / "keygen-avb.log")
        run(["openssl", "pkey", "-in", key_dir / "avb.pem", "-pubout",
             "-out", key_dir / "avb.pub.pem"], logs / "avb-public.log")
        run([avbtool_source, "extract_public_key", "--key", key_dir / "avb.pem",
             "--output", key_dir / "avb_pkmd.bin"],
            logs / "avb-pkmd.log")
        run(["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt",
             "rsa_keygen_bits:4096", "-out", wrong_dir / "avb.pem"],
            logs / "keygen-wrong-avb.log")
        run(["openssl", "pkey", "-in", wrong_dir / "avb.pem", "-pubout",
             "-out", wrong_dir / "avb.pub.pem"],
            logs / "wrong-avb-public.log")
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f",
             key_dir / "factory"], logs / "keygen-factory.log")
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f",
             wrong_dir / "factory"], logs / "keygen-wrong-factory.log")

        public = partial / "public-keys"
        public.mkdir(mode=0o750)
        fingerprints = []
        for key_id in key_ids:
            source = key_dir / f"{key_id}.x509.pem"
            shutil.copy2(source, public / source.name)
            fingerprints.append({
                "key_id": key_id,
                "sha256": certificate_fingerprint(source),
            })
        for name in ("avb.pub.pem", "avb_pkmd.bin", "factory.pub"):
            shutil.copy2(key_dir / name, public / name)
        shutil.copy2(wrong_dir / "releasekey.x509.pem",
                     public / "wrong-releasekey.x509.pem")
        shutil.copy2(wrong_dir / "avb.pub.pem", public / "wrong-avb.pub.pem")
        shutil.copy2(wrong_dir / "factory.pub", public / "wrong-factory.pub")
        fingerprints.extend([
            {"key_id": "avb", "sha256": digest(public / "avb_pkmd.bin")},
            {"key_id": "factory", "sha256": digest(public / "factory.pub")},
        ])

        tool_dir = partial / ".otatools"
        tool_dir.mkdir(mode=0o750)
        run(["unzip", "-q", str(ota_otatools), "-d", str(tool_dir)],
            logs / "unpack-otatools.log")
        tool_bin = tool_dir / "bin"
        required_tools = {
            name: tool_bin / name for name in (
                "sign_target_files_apks", "ota_from_target_files",
                "img_from_target_files", "apksigner", "avbtool",
                "check_ota_package_signature",
            )
        }
        if any(not path.is_file() for path in required_tools.values()):
            raise Failure("reviewed otatools package lacks a required verifier")
        qualification_env = base_env.copy()
        jdk_bin = source_root / "prebuilts/jdk/jdk21/linux-x86/bin"
        qualification_env["PATH"] = (
            f"{tool_bin}:{jdk_bin}:"
            f"{source_root}/prebuilts/build-tools/linux-x86/bin:"
            f"{source_root}/prebuilts/build-tools/path/linux-x86:"
            f"{base_env['PATH']}")
        qualification_env["TMPDIR"] = str(workspace / "tmp")

        # Exercise the exact APK tool/JDK/output contract before either large
        # target-files transformation. This is an early diagnostic only; final
        # independent verification still runs after private-key deletion.
        _, smoke_candidates, _ = target_apk_role_coverage(
            ((sdk_profile_id, sdk_unsigned, sdk_unsigned_inventory),), key_ids)
        if not smoke_candidates:
            raise Failure("no APK is available for verifier preflight")
        smoke_record = min(smoke_candidates.values(), key=lambda item: item["bytes"])
        smoke_input = extract_selected_apk_samples(
            ((sdk_profile_id, sdk_unsigned, sdk_unsigned_inventory),),
            {"input": smoke_record}, transient_root / "verifier-preflight")["input"]
        smoke_signed = transient_root / "verifier-preflight/signed.apk"
        run([required_tools["apksigner"], "sign", "--key", key_dir / "releasekey.pk8",
             "--cert", key_dir / "releasekey.x509.pem", "--min-sdk-version", "35",
             "--out", smoke_signed, smoke_input],
            logs / "verifier-preflight-sign.log", env=qualification_env)
        apk_certificate_check(
            required_tools["apksigner"], smoke_signed,
            certificate_fingerprint(public / "releasekey.x509.pem"),
            logs / "verifier-preflight-check.log", env=qualification_env)

        artifacts = partial / "artifacts"
        artifacts.mkdir(mode=0o750)
        sdk_signed = artifacts / "sdk-signed-target-files.zip"
        ota_signed = artifacts / "ota-signed-target-files.zip"
        ota_prepared = transient_root / "ota-prepared-target-files.zip"
        prepare_ota_custom_vbmeta_input(
            ota_unsigned, ota_prepared, transient_root / "preparation",
            partial / "ota-input-preparation.json",
            logs / "ota-input-preparation.log", key_dir)
        sdk_sign_command = planner.signing_command(
            sdk_unsigned_inventory,
            signer=required_tools["sign_target_files_apks"],
            key_dir=key_dir, source=sdk_unsigned, destination=sdk_signed)
        ota_sign_command = planner.signing_command(
            ota_unsigned_inventory,
            signer=required_tools["sign_target_files_apks"],
            key_dir=key_dir, source=ota_prepared, destination=ota_signed,
            prepared_custom_vbmeta_chains=tuple(
                OTA_CUSTOM_VBMETA_PARTITIONS.values()))
        for command in (sdk_sign_command, ota_sign_command):
            if ("--override_apk_keys" in command
                    or "--override_apex_keys" in command):
                raise Failure("global key override is prohibited")
        run(sdk_sign_command, logs / "sign-sdk-target-files.log",
            cwd=source_root, env=qualification_env)
        run(ota_sign_command, logs / "sign-ota-target-files.log",
            cwd=source_root, env=qualification_env)
        run([
            tools_root / "bin/diamaneos", "signing", "inventory",
            "--profile", sdk_profile_id, "--stage", "signed",
            "--source-inventory", partial / "sdk-unsigned-inventory.json",
            "--target-files", sdk_signed, "--output",
            partial / "sdk-signed-inventory.json",
        ], logs / "sdk-signed-inventory.log", env=base_env)
        sdk_signed_inventory = signing_verify.load_json(
            partial / "sdk-signed-inventory.json", limit=64 * 1024 * 1024)
        run([
            tools_root / "bin/diamaneos", "signing", "inventory",
            "--profile", ota_profile_id, "--stage", "signed",
            "--source-inventory", partial / "ota-unsigned-inventory.json",
            "--target-files", ota_signed, "--output",
            partial / "ota-signed-inventory.json",
        ], logs / "ota-signed-inventory.log", env=base_env)
        ota_signed_inventory = signing_verify.load_json(
            partial / "ota-signed-inventory.json", limit=64 * 1024 * 1024)
        if (sdk_signed_inventory["status"] != "PASS"
                or ota_signed_inventory["status"] != "PASS"
                or digest(sdk_signed) == digest(sdk_unsigned)
                or digest(ota_signed) == digest(ota_unsigned)):
            raise Failure("signed target-files transformation was not accepted")

        apk_sources = (
            (sdk_profile_id, sdk_signed, sdk_signed_inventory),
            (ota_profile_id, ota_signed, ota_signed_inventory),
        )
        apk_metadata_counts, apk_selected, apk_candidates = (
            target_apk_role_coverage(apk_sources, key_ids))
        if any(sum(apk_metadata_counts[role].values()) == 0
               for role in key_ids):
            raise Failure("accepted target metadata omits a required APK role")
        metadata_only_roles = set(key_ids) - set(apk_selected)
        if metadata_only_roles != expected_metadata_only_roles:
            raise Failure("target APK role payload coverage is not reviewed")

        probe_source_record = min(
            apk_selected.values(),
            key=lambda item: (
                item["bytes"], item["profile_id"].encode("utf-8"),
                item["package_name"].encode("utf-8"),
                item["member_path"].encode("utf-8"),
            ),
        )
        probe_source = extract_selected_apk_samples(
            apk_sources, {"probe-source": probe_source_record},
            transient_root / "apk-role-probe-source")["probe-source"]
        role_probe_dir = artifacts / "apk-role-probes"
        role_probe_dir.mkdir(mode=0o750)
        role_probe_paths = {}
        for role in sorted(
                metadata_only_roles, key=lambda item: item.encode("utf-8")):
            probe = role_probe_dir / f"{role}.apk"
            run([
                required_tools["apksigner"], "sign",
                "--key", key_dir / f"{role}.pk8",
                "--cert", key_dir / f"{role}.x509.pem",
                "--min-sdk-version", "35", "--out", probe, probe_source,
            ], logs / f"sign-apk-role-probe-{role}.log",
                env=qualification_env)
            if probe.is_symlink() or not probe.is_file() or probe.stat().st_size == 0:
                raise Failure("standalone APK role probe was not created")
            role_probe_paths[role] = probe

        role_coverage = partial / "apk-role-coverage.json"
        atomic_json(role_coverage, {
            "schema_version": 1,
            "status": "PASS",
            "scope": (
                "accepted SDK and OTA target-files union plus explicit "
                "standalone disposable-key probes for metadata-only roles"),
            "metadata_only_roles": sorted(
                metadata_only_roles, key=lambda item: item.encode("utf-8")),
            "probe_source": probe_source_record,
            "roles": [
                {
                    "role": role,
                    "metadata_records_by_profile": apk_metadata_counts[role],
                    "artifact_backed_candidate_count": len(
                        apk_candidates.get(role, [])),
                    "qualification_mode": (
                        "target-files-transformation"
                        if role in apk_selected
                        else "standalone-apk-signing-probe"),
                    "target_files_transformation_observed": role in apk_selected,
                    "selected_target_artifact": apk_selected.get(role),
                    "standalone_probe_path": (
                        role_probe_paths[role].relative_to(partial).as_posix()
                        if role in role_probe_paths else None),
                }
                for role in key_ids
            ],
        })
        shutil.rmtree(transient_root)

        full_ota = artifacts / "full-ota.zip"
        incremental_ota = artifacts / "incremental-noop-ota.zip"
        run([required_tools["ota_from_target_files"], "-k",
             key_dir / "releasekey", ota_signed, full_ota],
            logs / "full-ota.log", cwd=source_root, env=qualification_env)
        run([required_tools["ota_from_target_files"], "-k",
             key_dir / "releasekey", "-i", ota_signed, ota_signed,
             incremental_ota],
            logs / "incremental-ota.log", cwd=source_root,
            env=qualification_env)
        metadata_before = set(artifacts.iterdir())
        run([source_root / "script/generate-metadata", full_ota],
            logs / "generate-metadata.log", cwd=source_root,
            env=qualification_env)
        metadata_files = sorted(set(artifacts.iterdir()) - metadata_before)
        if len(metadata_files) != 4:
            raise Failure("update metadata generator did not produce four channels")
        image_archive = artifacts / "generic-images.zip"
        run([required_tools["img_from_target_files"], sdk_signed, image_archive],
            logs / "image-archive.log", cwd=source_root,
            env=qualification_env)

        run(["ssh-keygen", "-Y", "sign", "-n", "factory images", "-f",
             key_dir / "factory", image_archive],
            logs / "factory-sign.log")
        factory_signature = image_archive.with_name(image_archive.name + ".sig")
        release_manifest = partial / "release-manifest.json"
        core_paths = [sdk_signed, ota_signed, full_ota, incremental_ota,
                      image_archive, role_coverage,
                      *role_probe_paths.values(), *metadata_files]
        atomic_json(release_manifest, {
            "schema_version": 1,
            "run_id": run_id,
            "profile_ids": [sdk_profile_id, ota_profile_id],
            "source_binding": config["source_binding"],
            "incremental_scope": (
                "same-build no-op delta qualifies the full incremental signing "
                "and verification route, not changed-build update semantics"),
            "artifacts": [
                {"path": path.relative_to(partial).as_posix(),
                 "sha256": digest(path), "bytes": path.stat().st_size}
                for path in core_paths
            ],
            "key_public_fingerprints": sorted(
                fingerprints, key=lambda item: item["key_id"]),
        })
        run(["ssh-keygen", "-Y", "sign", "-n",
             "diamaneos-dummy-release-record", "-f", key_dir / "factory",
             release_manifest], logs / "release-record-sign.log")
        release_signature = release_manifest.with_name(
            release_manifest.name + ".sig")

        factory_allowed = partial / "factory-allowed-signers"
        factory_wrong = partial / "factory-wrong-allowed-signers"
        release_allowed = partial / "release-allowed-signers"
        release_wrong = partial / "release-wrong-allowed-signers"
        public_key = (public / "factory.pub").read_text(encoding="utf-8").strip()
        wrong_key = (public / "wrong-factory.pub").read_text(
            encoding="utf-8").strip()
        factory_allowed.write_text(f"dummy-factory {public_key}\n", encoding="utf-8")
        factory_wrong.write_text(f"dummy-factory {wrong_key}\n", encoding="utf-8")
        release_allowed.write_text(f"dummy-release {public_key}\n", encoding="utf-8")
        release_wrong.write_text(f"dummy-release {wrong_key}\n", encoding="utf-8")

        shutil.rmtree(private_root)
        if private_root.exists():
            raise Failure("disposable private key directory survived signing")

        verify_signed_outputs(partial, config, required_tools, qualification_env)

        shutil.rmtree(tool_dir)
        retained = []
        for path in sorted(partial.rglob("*")):
            if path.is_file() and path.name not in {"result.json", "result.json.sha256"}:
                identifier = "a-" + hashlib.sha256(
                    path.relative_to(partial).as_posix().encode()).hexdigest()[:20]
                retained.append(artifact_record(identifier, partial, path))
        id_by_path = {entry["path"]: entry["id"] for entry in retained}
        evidence_all = [entry["id"] for entry in retained]
        proofs = [{
            "id": proof, "status": "PASS", "evidence_refs": evidence_all,
        } for proof in required_proofs]
        result_path = partial / "result.json"
        result = {
            "schema_version": 1,
            "inventory_id": config["inventory_id"],
            "source_binding": config["source_binding"],
            "profile_ids": [sdk_profile_id, ota_profile_id],
            "run_id": run_id,
            "status": "PASS",
            "dummy_keys_only": True,
            "production_material_present": False,
            "key_public_fingerprints": sorted(
                fingerprints, key=lambda item: item["key_id"]),
            "proofs": proofs,
            "artifacts": retained,
            "factory_archive_proof": {
                "manifest_path": image_archive.relative_to(partial).as_posix(),
                "signature_path": factory_signature.relative_to(partial).as_posix(),
                "allowed_signers_path": factory_allowed.relative_to(partial).as_posix(),
                "wrong_allowed_signers_path": factory_wrong.relative_to(partial).as_posix(),
                "identity": "dummy-factory", "namespace": "factory images",
            },
            "release_record_proof": {
                "manifest_path": release_manifest.relative_to(partial).as_posix(),
                "signature_path": release_signature.relative_to(partial).as_posix(),
                "allowed_signers_path": release_allowed.relative_to(partial).as_posix(),
                "wrong_allowed_signers_path": release_wrong.relative_to(partial).as_posix(),
                "identity": "dummy-release",
                "namespace": "diamaneos-dummy-release-record",
            },
        }
        atomic_json(result_path, result)
        verify_errors = signing_verify.verify_dummy_result(
            result_path, partial, config)
        if verify_errors:
            raise Failure("retained dummy signing result did not verify")
        (partial / "result.json.sha256").write_text(
            f"{digest(result_path)}  result.json\n", encoding="utf-8")
        os.rename(partial, final)
        print("DUMMY_SIGNING_QUALIFICATION=PASS")
        print(f"run_id={run_id}")
        print(f"result={final / 'result.json'}")
        print((final / "result.json.sha256").read_text().strip())
        return 0
    except (Exception, KeyboardInterrupt) as error:
        if private_root.exists():
            shutil.rmtree(private_root)
        if transient_root.exists():
            shutil.rmtree(transient_root)
        if (partial / ".otatools").exists():
            shutil.rmtree(partial / ".otatools")
        atomic_json(partial / "failure.json", {
            "schema_version": 1, "run_id": run_id, "status": "FAIL",
            "started_at_utc": started,
            "ended_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "error": str(error), "private_material_retained": False,
        })
        failed = evidence_root / f"{run_id}.failed"
        os.rename(partial, failed)
        print(f"ERROR: {error}", file=sys.stderr)
        print("DUMMY_SIGNING_QUALIFICATION=FAIL", file=sys.stderr)
        print(f"result={failed / 'failure.json'}", file=sys.stderr)
        return 1


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--recovery-child":
        return qualify()
    if pwd.getpwuid(os.geteuid()).pw_name != EXPECTED_USER or os.geteuid() == 0:
        raise Failure(f"run as the unprivileged {EXPECTED_USER} identity")
    workspace = Path(os.environ.get("DIAMANEOS_BUILD_ROOT", "/var/lib/diamaneos-build"))
    if not workspace.is_absolute() or workspace.is_symlink() or not workspace.is_dir():
        raise Failure("workspace must be an absolute non-symlink directory")
    fd = os.open(workspace / ".workspace.lock",
                 os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Failure("workspace lock is not a regular file")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Failure("another builder operation owns this workspace") from None
        def interrupt(_signum, _frame):
            raise KeyboardInterrupt
        previous = signal.signal(signal.SIGTERM, interrupt)
        try:
            return qualify()
        finally:
            signal.signal(signal.SIGTERM, previous)
    finally:
        os.close(fd)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Failure as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(1)
