#!/bin/bash
set -euo pipefail

tools_root=${1:-}
workspace_root=${2:-/var/lib/diamaneos-build}
config_relative=${3:-config/build-environment.json}
overlay_root=${4:-}
reference_root=${DIAMANEOS_SOURCE_REFERENCE:-}
expected_tools_commit=${DIAMANEOS_EXPECTED_TOOLS_COMMIT:-}
expected_user=diamaneos-build
thermal_check=${DIAMANEOS_THERMAL_CHECK:-}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ -n $tools_root && -x $tools_root/bin/diamaneos ]] || \
  fail "usage: sync-pinned-source <reviewed-tools-root> [workspace-root] [config-relative-path] [overlay-repository]"
[[ $(id -un) == "$expected_user" ]] || fail "run as $expected_user"
[[ $expected_tools_commit =~ ^[0-9a-f]{40}$ ]] || \
  fail "DIAMANEOS_EXPECTED_TOOLS_COMMIT is missing or invalid"
[[ $thermal_check == /* ]] || \
  fail "DIAMANEOS_THERMAL_CHECK must name an explicit absolute path"
tools_root=$(readlink -f "$tools_root")
config_path=$(readlink -f "$tools_root/$config_relative")
[[ $config_path == "$tools_root"/config/*.json && -f $config_path ]] || fail "configuration must be inside reviewed tools/config"
reference_args=()
if [[ -n $reference_root ]]; then
  [[ $reference_root == /* && -d $reference_root/.repo/project-objects ]] || fail "invalid source object reference"
  reference_args=(--reference "$reference_root")
fi
observed_tools_commit=$(git -c safe.directory="$tools_root" \
  -C "$tools_root" rev-parse HEAD)
[[ $observed_tools_commit == "$expected_tools_commit" ]] || \
  fail "reviewed tools commit mismatch"
[[ -z $(git -c safe.directory="$tools_root" -C "$tools_root" \
  status --porcelain=v1 --untracked-files=all) ]] || \
  fail "reviewed tools checkout is dirty"
[[ -z $(find "$tools_root" -xdev -perm /022 -print -quit) ]] || \
  fail "reviewed tools checkout is writable by group or other"
[[ $workspace_root == /* ]] || fail "workspace root must be absolute"
[[ ! -L $workspace_root ]] || fail "workspace root must not be a symlink"

# This descriptor stays open through preflight, execution and final evidence.
[[ -d $workspace_root && ! -L $workspace_root/.workspace.lock ]] || \
  fail 'workspace lock path is unavailable'
exec 9>"$workspace_root/.workspace.lock"
flock -n 9 || fail 'another builder operation owns this workspace'

# The portable check binds this script invocation to the exact reviewed config
# and inventories every non-runtime input before any network or source change.
"$tools_root/bin/diamaneos" build preflight --config "$config_path" --inputs-only

mapfile -t declared_workspace < <(python3 - \
  "$config_path" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    config = json.load(stream)
workspace = config["workspace"]
print(workspace["source_subdirectory"])
print(workspace["cache_subdirectory"])
print(workspace["output_subdirectory"])
upstream = config["upstream"]
print(upstream["release_tag"])
print(upstream["tag_object"])
print(upstream["peeled_commit"])
print(upstream["allowed_signers_url"])
print(upstream["allowed_signers_sha256"])
print(upstream["manifest_url"])
repo_tool = upstream["repo_tool"]
print(repo_tool["url"])
print(repo_tool["release_tag"])
print(repo_tool["tag_object"])
print(repo_tool["peeled_commit"])
print("yes" if "composition" in config else "no")
PY
)
[[ ${#declared_workspace[@]} -eq 14 ]] || \
  fail "declared workspace, release or repo-tool pins are incomplete"
source_root=$workspace_root/${declared_workspace[0]}
cache_root=$workspace_root/${declared_workspace[1]}
output_root=$workspace_root/${declared_workspace[2]}
tag=${declared_workspace[3]}
tag_object=${declared_workspace[4]}
peeled_commit=${declared_workspace[5]}
allowed_signers_url=${declared_workspace[6]}
allowed_signers_sha256=${declared_workspace[7]}
manifest_url=${declared_workspace[8]}
repo_tool_url=${declared_workspace[9]}
repo_tool_tag=${declared_workspace[10]}
repo_tool_tag_object=${declared_workspace[11]}
repo_tool_commit=${declared_workspace[12]}
if [[ ${declared_workspace[13]} == yes ]]; then
  [[ $overlay_root == /* && -d $overlay_root ]] || fail "composed environment requires an absolute overlay repository"
else
  [[ -z $overlay_root ]] || fail "upstream-only environment cannot use an overlay"
fi
allowed_signers=$cache_root/trust/grapheneos-allowed-signers-$tag
[[ ! -L $source_root && ! -L $cache_root && ! -L $output_root ]] || \
  fail "workspace roots must not be symlinks"

install -d -m 0750 "$source_root"
if [[ ! -d $source_root/.repo ]]; then
  # A previous preflight may have created the declared empty source-local out.
  if [[ $(dirname "$output_root") == "$source_root" && -d $output_root ]]; then
    [[ -z $(find "$output_root" -mindepth 1 -print -quit) ]] || \
      fail "new source output is not empty"
    [[ -z $(find "$source_root" -mindepth 1 -maxdepth 1 ! -path "$output_root" -print -quit) ]] || \
      fail "new source root contains undeclared content"
  else
    [[ -z $(find "$source_root" -mindepth 1 -maxdepth 1 -print -quit) ]] || \
      fail "new source root is not empty"
  fi
fi

install -d -m 0750 "$cache_root/trust" "$output_root"

PATH="$workspace_root/toolbin:/usr/local/bin:/usr/bin:/bin" \
  "$tools_root/bin/diamaneos" build preflight --config "$config_path" \
    --host-only \
    --purpose generic-qualification \
    --source-root "$source_root" \
    --cache-root "$cache_root" \
    --output-root "$output_root" \
    --thermal-check "$thermal_check" \
    --require-empty-output

temporary_signers=$(mktemp "$cache_root/trust/.allowed-signers.XXXXXX")
cleanup() {
  if [[ -n ${temporary_signers:-} ]]; then
    rm -f -- "$temporary_signers"
  fi
}
trap cleanup EXIT
curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
  "$allowed_signers_url" -o "$temporary_signers"
printf '%s  %s\n' "$allowed_signers_sha256" "$temporary_signers" | sha256sum -c -
chmod 0640 "$temporary_signers"
mv -f -- "$temporary_signers" "$allowed_signers"
temporary_signers=

cd "$source_root"
# An existing repo launcher delegates into this checkout during init itself.
if [[ -d .repo/repo ]]; then
  [[ -z $(git -C .repo/repo status --porcelain=v1 --untracked-files=all) ]] || \
    fail "repo implementation checkout is dirty before init"
fi
repo init "${reference_args[@]}" -u "$manifest_url" \
  -b "refs/tags/$tag" \
  --repo-url="$repo_tool_url" \
  --repo-rev="$repo_tool_commit"

repo_tool_git=$source_root/.repo/repo
[[ -z $(git -C "$repo_tool_git" status --porcelain=v1 --untracked-files=all) ]] || \
  fail "repo implementation checkout is dirty"
[[ $(git -C "$repo_tool_git" remote get-url origin) == "$repo_tool_url" ]] || \
  fail "repo implementation origin mismatch"
[[ $(git -C "$repo_tool_git" rev-parse HEAD) == "$repo_tool_commit" ]] || \
  fail "repo implementation commit mismatch"
[[ $(git -C "$repo_tool_git" rev-parse "$repo_tool_tag^{tag}") == "$repo_tool_tag_object" ]] || \
  fail "repo implementation tag object mismatch"
[[ $(git -C "$repo_tool_git" rev-parse "$repo_tool_tag^{}") == "$repo_tool_commit" ]] || \
  fail "repo implementation tag commit mismatch"
GNUPGHOME="$HOME/.repoconfig/gnupg" \
  git -C "$repo_tool_git" verify-tag "$repo_tool_tag"

manifest_git=$source_root/.repo/manifests
[[ $(git -C "$manifest_git" rev-parse "$tag^{tag}") == "$tag_object" ]] || \
  fail "manifest tag object mismatch"
[[ $(git -C "$manifest_git" rev-parse "$tag^{}") == "$peeled_commit" ]] || \
  fail "manifest peeled commit mismatch"
git -C "$manifest_git" -c "gpg.ssh.allowedSignersFile=$allowed_signers" \
  verify-tag "$tag"

if [[ -n $overlay_root ]]; then
  PYTHONPATH="$tools_root/src" PYTHONDONTWRITEBYTECODE=1 python3 -m diamaneos_tools.build_composition prepare \
    --config "$config_path" --source-root "$source_root" --overlay-root "$overlay_root"
fi

# No fallback branch, partial success path or stale checkout is accepted.
repo sync -j8

if [[ -n $overlay_root ]]; then
  PYTHONPATH="$tools_root/src" PYTHONDONTWRITEBYTECODE=1 python3 -m diamaneos_tools.build_composition checkout \
    --config "$config_path" --source-root "$source_root"
fi

PATH="$workspace_root/toolbin:$PATH" \
  "$tools_root/bin/diamaneos" build preflight --config "$config_path" \
    --purpose generic-qualification \
    --source-root "$source_root" \
    --cache-root "$cache_root" \
    --output-root "$output_root" \
    --thermal-check "$thermal_check" \
    --require-empty-output \
    --allowed-signers "$allowed_signers"

printf 'PINNED_SOURCE_SYNC=PASS\n'
