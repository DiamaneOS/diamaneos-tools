[Unit]
Description=DiamaneOS pinned Virtual A/B OTA signing-role discovery
After=diamaneos-builder-source-sync.service
ConditionPathIsSymbolicLink=/opt/diamaneos/tools

[Service]
Type=oneshot
User=diamaneos-build
Group=diamaneos-build
WorkingDirectory=/var/lib/diamaneos-build
Environment=HOME=/var/lib/diamaneos-build
Environment=COREPACK_HOME=/var/lib/diamaneos-build/.cache/corepack
Environment=PATH=/var/lib/diamaneos-build/toolbin:/usr/local/bin:/usr/bin:/bin
Environment=DIAMANEOS_TOOLS_ROOT=/opt/diamaneos/tools
Environment=DIAMANEOS_SIGNING_PROFILE_ID=generic-x86_64-ota-qualification
Environment=DIAMANEOS_DISCOVERY_RUN_PREFIX=ota-signing-discovery
EnvironmentFile=/etc/diamaneos/builder-signing-discovery.env
UMask=0027
ExecStart=/opt/diamaneos/tools/deploy/builder/run-signing-discovery
TimeoutStartSec=infinity
Restart=no
RemainAfterExit=yes
StandardOutput=append:/var/log/diamaneos-builder/ota-signing-discovery.log
StandardError=append:/var/log/diamaneos-builder/ota-signing-discovery.log
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
