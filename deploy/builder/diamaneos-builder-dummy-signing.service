[Unit]
Description=DiamaneOS disposable signing pipeline qualification
After=diamaneos-builder-source-sync.service
ConditionPathIsSymbolicLink=/opt/diamaneos/tools

[Service]
Type=oneshot
User=diamaneos-build
Group=diamaneos-build
WorkingDirectory=/var/lib/diamaneos-build
Environment=HOME=/var/lib/diamaneos-build
Environment=COREPACK_HOME=/var/lib/diamaneos-build/.cache/corepack
Environment=PATH=/var/lib/diamaneos-build/toolbin:/opt/nodejs/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=DIAMANEOS_TOOLS_ROOT=/opt/diamaneos/tools
EnvironmentFile=/etc/diamaneos/builder-dummy-signing.env
UMask=0027
ExecStart=/opt/diamaneos/tools/deploy/builder/run-dummy-signing-qualification
TimeoutStartSec=infinity
Restart=no
RemainAfterExit=yes
StandardOutput=append:/var/log/diamaneos-builder/dummy-signing.log
StandardError=append:/var/log/diamaneos-builder/dummy-signing.log
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
