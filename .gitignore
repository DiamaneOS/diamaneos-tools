# Private and generated state — never commit
/private/
*.log
*.orig
*.rej
.DS_Store

# Signing secrets and credentials — never in git
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*id_rsa*
*id_ed25519*
.env
.env.*
secrets*.json
*token*.json
# Loose text files are never committed; add a wanted one with `git add -f`.
*.txt
!requirements-dev.txt

# Local notes, captures and run records
private-*/
/artifacts/
/baselines/
/devices/

# Build outputs and large checkouts
os/
manifest/
out/
.cache/

# Local Python development environment and caches
.venv/
__pycache__/
*.py[cod]
