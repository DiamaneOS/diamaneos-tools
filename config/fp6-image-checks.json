{
  "schema_version": 1,
  "scope": "Per-build device checks. build verify runs every rule on the exported image set; each rule states why it exists. Paths are target-files member paths; kernel: paths are files of the recorded kernel run.",
  "rules": [
    {
      "id": "sensors-stack",
      "why": "Sensors work on stock and on DiamaneOS: the multi-HAL, the Qualcomm sensor listener and its policy.",
      "type": "files_present",
      "paths": [
        "VENDOR/bin/hw/android.hardware.sensors-service.multihal",
        "VENDOR/bin/sscrpcd",
        "VENDOR/lib64/sensors.qsh.so",
        "VENDOR/lib64/libssc_default_listener.so",
        "VENDOR/lib64/libadsp_default_listener.so",
        "VENDOR/etc/sensors/hals.conf",
        "VENDOR/etc/init/vendor.sensors.sscrpcd.rc",
        "VENDOR/etc/permissions/android.hardware.sensor.light.xml"
      ]
    },
    {
      "id": "sensors-declared",
      "why": "The sensors HAL is declared and its daemon is labelled.",
      "type": "text",
      "files": [
        "VENDOR/etc/vintf/manifest/*.xml"
      ],
      "match": "any",
      "contains": [
        "android.hardware.sensors"
      ]
    },
    {
      "id": "sensors-labelled",
      "why": "The sensor daemon (sscrpcd) and the audio DSP daemon (audioadsprpcd) have their own labels.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_file_contexts"
      ],
      "contains": [
        "sscrpcd",
        "audioadsprpcd"
      ]
    },
    {
      "id": "fingerprint-hal",
      "why": "The source fingerprint HAL is installed.",
      "type": "files_present",
      "paths": [
        "VENDOR/bin/hw/android.hardware.biometrics.fingerprint-service.fp6"
      ]
    },
    {
      "id": "device-overlays",
      "why": "The FP6 framework, Settings, SystemUI and tethering overlays are installed.",
      "type": "files_present",
      "paths": [
        "VENDOR/overlay/FP6FrameworksOverlay.apk",
        "VENDOR/overlay/FP6SettingsOverlay.apk",
        "VENDOR/overlay/FP6SystemUIOverlay.apk",
        "VENDOR/overlay/FP6TetheringOverlay.apk"
      ]
    },
    {
      "id": "audio-stack",
      "why": "Stock audio user space with the AOSP service and adapters; no placeholder HAL.",
      "type": "files_present",
      "paths": [
        "VENDOR/lib64/hw/audio.primary.volcano.so",
        "VENDOR/lib64/libar-pal.so",
        "VENDOR/lib64/libagm.so",
        "VENDOR/lib64/libar-gsl.so",
        "VENDOR/lib64/libagm_pcm_plugin.so",
        "VENDOR/lib64/soundfx/libqcompostprocbundle.so",
        "VENDOR/bin/audioadsprpcd",
        "VENDOR/bin/hw/android.hardware.audio.service",
        "VENDOR/lib64/hw/android.hardware.audio@7.1-impl.so",
        "VENDOR/lib64/hw/android.hardware.audio.effect@7.0-impl.so",
        "VENDOR/etc/usecaseKvManager_fps.xml",
        "VENDOR/etc/card-defs.xml",
        "VENDOR/etc/audio/sku_volcano/audio_policy_configuration.xml",
        "VENDOR/etc/audio/sku_volcano/resourcemanager_volcano_mtp_fps.xml",
        "VENDOR/etc/acdbdata/volcano_mtp_fps/MTP_acdb_cal.acdb",
        "VENDOR/firmware/aw882xx_acf.bin",
        "VENDOR/etc/init/init.fp6.audio.rc",
        "VENDOR/etc/init/vendor.qti.audio-adsprpc-service.rc"
      ]
    },
    {
      "id": "audio-no-apex",
      "why": "The AOSP audio APEX would shadow the stock HAL.",
      "type": "files_absent",
      "paths": [
        "VENDOR/apex/com.android.hardware.audio.apex"
      ]
    },
    {
      "id": "audio-declared",
      "why": "PAL and AGM are declared in the vendor manifest.",
      "type": "text",
      "files": [
        "VENDOR/etc/vintf/manifest.xml"
      ],
      "contains": [
        "vendor.qti.hardware.pal",
        "vendor.qti.hardware.AGMIPC",
        "android.hardware.bluetooth"
      ]
    },
    {
      "id": "hardware-bringup",
      "why": "Hardware bring-up: Bluetooth, NFC, radio, modem, camera, GNSS, display, haptics and their activation files.",
      "type": "files_present",
      "paths": [
        "VENDOR/bin/hw/android.hardware.bluetooth@1.1-service-qti",
        "VENDOR/bin/hw/android.hardware.nfc-service.sec",
        "VENDOR/bin/hw/qcrilNrd",
        "VENDOR/bin/nicmd",
        "VENDOR/bin/ssr_setup",
        "VENDOR/bin/hw/vendor.qti.camera.provider-service_64",
        "VENDOR/bin/hw/android.hardware.gnss-aidl-service-qti",
        "VENDOR/lib64/libsdmextension.so",
        "VENDOR/lib64/libdisplayqos.so",
        "VENDOR/lib64/hw/camera.qcom.so",
        "VENDOR/firmware/haptic_ram.bin",
        "VENDOR/etc/gps.conf",
        "VENDOR/etc/izat.conf",
        "VENDOR/etc/libnfc-sec-vendor.conf",
        "VENDOR/etc/displayconfig/display_id_4630947039571902850.xml",
        "VENDOR/etc/init/init.fp6.perf.rc",
        "VENDOR/etc/init/init.fp6.modem.rc",
        "VENDOR/etc/init/init.fp6.bluetooth.rc",
        "VENDOR/etc/permissions/android.hardware.bluetooth.xml",
        "VENDOR/etc/permissions/android.hardware.nfc.xml",
        "VENDOR/etc/permissions/android.hardware.location.gps.xml",
        "VENDOR/etc/permissions/android.hardware.camera.flash-autofocus.xml",
        "VENDOR/lib64/android.hardware.graphics.allocator-V1-ndk.so",
        "VENDOR/lib64/android.hardware.graphics.allocator-V2-ndk.so"
      ]
    },
    {
      "id": "display-port-config",
      "why": "The built-in display config is also reachable by port.",
      "type": "symlink",
      "path": "VENDOR/etc/displayconfig/display_port_130.xml",
      "target": "display_id_4630947039571902850.xml"
    },
    {
      "id": "sdm-extension-libraries",
      "why": "Libraries the SDM extension loads by name (a first-boot composer crash).",
      "type": "files_present",
      "paths": [
        "VENDOR/lib64/libsdm-colormgr-algo.so",
        "VENDOR/lib64/libqseed3.so",
        "VENDOR/lib64/librcmask.so",
        "VENDOR/lib64/libclstc_tm.so",
        "VENDOR/lib64/libhdr_tm.so",
        "VENDOR/lib64/libhdr_backlight_adapter.so"
      ]
    },
    {
      "id": "no-hearing-aid-policy",
      "why": "The unused hearing-aid audio policy stays out.",
      "type": "files_absent",
      "paths": [
        "VENDOR/etc/bluetooth_qti_hearing_aid_audio_policy_configuration.xml"
      ]
    },
    {
      "id": "telephony-features",
      "why": "prebuilt_etc installs the telephony feature files under their module names.",
      "type": "files_present",
      "paths": [
        "VENDOR/etc/permissions/android.hardware.telephony.gsm.prebuilt.xml",
        "VENDOR/etc/permissions/android.hardware.telephony.ims.prebuilt.xml",
        "VENDOR/etc/permissions/android.hardware.telephony.euicc.prebuilt.xml",
        "SYSTEM_EXT/priv-app/ims/ims.apk",
        "PRODUCT/priv-app/uimlpaservice/uimlpaservice.apk"
      ]
    },
    {
      "id": "policy-labels",
      "why": "Bluetooth, SSR and GNSS domains exist in the vendor policy.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_file_contexts",
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "match": "any",
      "contains": [
        "hal_bluetooth_default",
        "vendor_ssr_setup_exec",
        "hal_gnss_qti"
      ]
    },
    {
      "id": "zram",
      "why": "zram swap stays configured.",
      "type": "text",
      "files": [
        "VENDOR/etc/fstab.qcom"
      ],
      "contains": [
        "zram0"
      ]
    },
    {
      "id": "no-forced-colour-mode",
      "why": "The forced colour mode is gone.",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "absent": [
        "persist.sys.sf.color_mode"
      ]
    },
    {
      "id": "call-audio-bridge",
      "why": "Our own call-audio bridge replaces QtiTelephonyService: one normal permission, our key, its own domain.",
      "type": "files_present",
      "paths": [
        "SYSTEM_EXT/priv-app/FP6CallAudio/FP6CallAudio.apk"
      ]
    },
    {
      "id": "call-audio-bridge-no-stock",
      "why": "The stock QtiTelephonyService is gone.",
      "type": "files_absent",
      "paths": [
        "SYSTEM_EXT/priv-app/QtiTelephonyService"
      ]
    },
    {
      "id": "call-audio-bridge-policy",
      "why": "The bridge is protected from disabling and runs in its own domain.",
      "type": "text",
      "files": [
        "SYSTEM_EXT/etc/sysconfig/sysconfig-de.diamaneos.callaudio.xml"
      ],
      "contains": [
        "prevent-disable package=\"de.diamaneos.callaudio\""
      ]
    },
    {
      "id": "call-audio-bridge-domain",
      "why": "The bridge has its seapp domain.",
      "type": "text",
      "files": [
        "SYSTEM_EXT/etc/selinux/system_ext_seapp_contexts"
      ],
      "lines": [
        "user=_app isPrivApp=true name=de.diamaneos.callaudio domain=fp6_callaudio_app type=app_data_file levelFrom=all"
      ]
    },
    {
      "id": "call-audio-bridge-rules",
      "why": "The bridge reaches only the QCRIL audio service and rild.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "regex": [
        "^\\(allow fp6_callaudio_app(_[0-9]+)? fp6_hal_qcrilaudio_service \\(service_manager \\(find\\)\\)\\)",
        "^\\(allow fp6_callaudio_app(_[0-9]+)? rild(_[0-9]+)? \\(binder \\(call transfer\\)\\)\\)",
        "^\\(allow rild(_[0-9]+)? fp6_callaudio_app(_[0-9]+)? \\(binder \\(call transfer\\)\\)\\)"
      ]
    },
    {
      "id": "call-audio-old-domain-gone",
      "why": "The old stock-app domain is gone.",
      "type": "text",
      "files": [
        "SYSTEM_EXT/etc/selinux/system_ext_seapp_contexts",
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "absent": [
        "fp6_qcril_audio_app"
      ]
    },
    {
      "id": "call-audio-bridge-apk",
      "why": "The bridge asks for one normal permission and is not platform-signed.",
      "type": "apk",
      "path": "SYSTEM_EXT/priv-app/FP6CallAudio/FP6CallAudio.apk",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "not_signed_like": "SYSTEM/framework/framework-res.apk"
    },
    {
      "id": "telephony-fixes",
      "why": "Telephony fixes from the first phone test.",
      "type": "files_present",
      "paths": [
        "VENDOR/etc/qcril_database/upgrade/config/0016.0_config.sql"
      ]
    },
    {
      "id": "telephony-properties",
      "why": "Default network mode, codec settings and the network-state poll window.",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "equals": [
        "ro.telephony.default_network=26,26",
        "debug.stagefright.c2inputsurface=-1",
        "debug.c2.use_dmabufheaps=1",
        "ro.telephony.network_state_poll_window_ms=5000"
      ]
    },
    {
      "id": "no-audio-routing-grant",
      "why": "The stock QCRIL audio messenger no longer gets MODIFY_AUDIO_ROUTING.",
      "type": "text",
      "files": [
        "SYSTEM_EXT/etc/permissions/privapp-permissions-fp6-telephony.xml"
      ],
      "absent": [
        "<permission name=\"android.permission.MODIFY_AUDIO_ROUTING\"/>"
      ]
    },
    {
      "id": "tipc-module",
      "why": "TIPC as a module without the diag module.",
      "type": "files_present",
      "paths": [
        "SYSTEM_DLKM/lib/modules/tipc.ko"
      ]
    },
    {
      "id": "tipc-loaded",
      "why": "TIPC is in the system_dlkm load list.",
      "type": "text",
      "files": [
        "SYSTEM_DLKM/lib/modules/modules.load"
      ],
      "lines": [
        "tipc.ko"
      ]
    },
    {
      "id": "no-diag-module",
      "why": "The diag module stays out.",
      "type": "files_absent",
      "paths": [
        "SYSTEM_DLKM/lib/modules/diag.ko"
      ]
    },
    {
      "id": "tipc-policy",
      "why": "TIPC sockets have policy.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "contains": [
        "tipc_socket"
      ]
    },
    {
      "id": "adb-authorization",
      "why": "adb asks before trusting a computer.",
      "type": "properties",
      "file": "SYSTEM/build.prop",
      "equals": [
        "ro.adb.secure=1"
      ]
    },
    {
      "id": "no-init-driven-adb",
      "why": "No init trigger starts adb on debuggable builds.",
      "type": "text",
      "files": [
        "VENDOR/etc/init/**"
      ],
      "match": "all",
      "absent": [
        "zygote-start && property:ro.debuggable=1"
      ]
    },
    {
      "id": "oem-unlocking",
      "why": "OEM unlocking managed by the OS, as stock.",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "equals": [
        "ro.frp.pst=/dev/block/bootdevice/by-name/frp",
        "ro.oem_unlock_supported=1"
      ]
    },
    {
      "id": "vendor-init-properties",
      "why": "vendor_init may set our audio, radio and SSR properties under enforcing (register -105).",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "regex": [
        "^\\(allow vendor_init(_[0-9]+)? vendor_audio_prop \\(property_service \\(set\\)\\)\\)",
        "^\\(allow vendor_init(_[0-9]+)? vendor_radio_prop \\(property_service \\(set\\)\\)\\)",
        "^\\(allow vendor_init(_[0-9]+)? vendor_ssr_prop \\(property_service \\(set\\)\\)\\)",
        "^\\(allow vendor_init(_[0-9]+)? vendor_dataqdp_prop \\(property_service \\(set\\)\\)\\)"
      ]
    },
    {
      "id": "display-colour-transforms",
      "why": "Night Light, Extra dim, grayscale and tap to wake.",
      "type": "overlay",
      "apk": "VENDOR/overlay/FP6FrameworksOverlay.apk",
      "values": {
        "bool/config_setColorTransformAccelerated": "true",
        "bool/config_nightDisplayAvailable": "true",
        "bool/config_reduceBrightColorsAvailable": "true",
        "bool/config_supportDoubleTapWake": "true"
      }
    },
    {
      "id": "poll-window-policy",
      "why": "The poll window property is labelled and read by the telephony framework fork.",
      "type": "text",
      "files": [
        "SYSTEM_EXT/etc/selinux/system_ext_property_contexts"
      ],
      "contains": [
        "ro.telephony.network_state_poll_window_ms"
      ]
    },
    {
      "id": "poll-window-framework",
      "why": "The telephony framework reads the poll window.",
      "type": "zip_contains",
      "file": "SYSTEM/framework/telephony-common.jar",
      "text": "network_state_poll_window_ms"
    },
    {
      "id": "vibrator",
      "why": "The vibrator HAL with real effects, its sysfs label, no RTP node for system, not in the input group.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "contains": [
        "vendor_sysfs_aw_vibrator"
      ]
    },
    {
      "id": "vibrator-rtp",
      "why": "The RTP node is not handed to system.",
      "type": "text",
      "files": [
        "VENDOR/etc/init/hw/init.qcom.rc"
      ],
      "absent": [
        "aw_vibrator/rtp"
      ]
    },
    {
      "id": "vibrator-group",
      "why": "The vibrator HAL is not in the input group.",
      "type": "text",
      "files": [
        "VENDOR/etc/init/vendor.qti.hardware.vibrator.service.rc"
      ],
      "absent_regex": [
        "^ *group .*\\binput\\b"
      ]
    },
    {
      "id": "time-daemon",
      "why": "Our own time daemon and no Qualcomm time_daemon policy.",
      "type": "files_present",
      "paths": [
        "VENDOR/bin/timekeepd"
      ]
    },
    {
      "id": "time-daemon-policy",
      "why": "Time daemon policy.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "contains": [
        "vendor_timekeepd_restore"
      ],
      "absent": [
        "vendor_time_daemon"
      ]
    },
    {
      "id": "no-wlan-mac-link",
      "why": "No wlan_mac.bin link into persist; the kernel may not read it.",
      "type": "files_absent",
      "paths": [
        "VENDOR/firmware/wlan/qca_cld/qca6750/wlan_mac.bin"
      ]
    },
    {
      "id": "keymaster-messages-on-odm",
      "why": "The stock KeyMint HAL keeps its libkeymaster_messages on odm; AOSP owns the vendor path.",
      "type": "files_present",
      "paths": [
        "ODM/lib64/libkeymaster_messages.so"
      ]
    },
    {
      "id": "keymaster-messages-not-vendor",
      "why": "No stock libkeymaster_messages on vendor.",
      "type": "files_absent",
      "paths": [
        "VENDOR/lib64/libkeymaster_messages.so"
      ]
    },
    {
      "id": "product-identity",
      "why": "Fairphone stock product identity, as GrapheneOS keeps Google's.",
      "type": "properties",
      "file": "PRODUCT/etc/build.prop",
      "equals": [
        "ro.product.product.brand=Fairphone",
        "ro.product.product.name=FP6",
        "ro.product.product.device=FP6",
        "ro.product.product.model=The Fairphone (Gen. 6)"
      ]
    },
    {
      "id": "fingerprint-identity",
      "why": "Every partition fingerprint carries the Fairphone identity.",
      "type": "property_prefix",
      "files": [
        "SYSTEM_EXT/etc/build.prop",
        "PRODUCT/etc/build.prop",
        "VENDOR/build.prop",
        "ODM/etc/build.prop"
      ],
      "key": "build.fingerprint",
      "prefix": "Fairphone/FP6/FP6:"
    },
    {
      "id": "casefolded-storage",
      "why": "Casefolded, project-quota shared storage (takes effect at the next wipe).",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "equals": [
        "external_storage.casefold.enabled=1",
        "external_storage.projid.enabled=1",
        "external_storage.sdcardfs.enabled=0"
      ]
    },
    {
      "id": "no-info-app",
      "why": "GrapheneOS's Info app is not installed.",
      "type": "files_absent",
      "paths": [
        "PRODUCT/app/InfoApp"
      ]
    },
    {
      "id": "tap-to-wake",
      "why": "Double-tap to wake: node permissions, label and power HAL access.",
      "type": "text",
      "files": [
        "VENDOR/etc/ueventd.rc"
      ],
      "regex": [
        "^/sys/bus/spi/devices/spi0\\.0 +gesture_wakeup +0660 +system +system$"
      ]
    },
    {
      "id": "tap-to-wake-label",
      "why": "The gesture node has its label.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_file_contexts"
      ],
      "contains": [
        "u:object_r:vendor_sysfs_touch_gesture:s0"
      ]
    },
    {
      "id": "tap-to-wake-policy",
      "why": "The power HAL may write the gesture node and search the touch device.",
      "type": "text",
      "files": [
        "VENDOR/etc/selinux/vendor_sepolicy.cil"
      ],
      "regex": [
        "^\\(allow hal_power_default vendor_sysfs_touch_gesture \\(file \\([^)]*\\bwrite\\b",
        "^\\(allow hal_power_default fp_mmitest_sysfs \\(dir \\([^)]*\\bsearch\\b"
      ]
    },
    {
      "id": "tap-to-wake-hal",
      "why": "The power HAL knows the gesture node.",
      "type": "text",
      "files": [
        "VENDOR/bin/hw/android.hardware.power-service"
      ],
      "contains": [
        "/sys/bus/spi/devices/spi0.0/gesture_wakeup"
      ]
    },
    {
      "id": "aod-brightness",
      "why": "Factory AOD idle brightness in every panel timing of the DTBO; no D2 at power-on (display device tree d94b9d8).",
      "type": "binary_count",
      "file": "kernel:dtbo.img",
      "patterns": [
        {
          "hex": "390000400000035109d9",
          "count": 0
        },
        {
          "hex": "39000040000003d20000",
          "count": 0
        },
        {
          "hex": "390000400000026f0439000040000003510003",
          "count": 40
        }
      ]
    },
    {
      "id": "stock-properties",
      "why": "Stock key, telephony and audio properties, each set once (stock property review).",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "equals": [
        "remote_provisioning.hostname=remoteprovisioning.googleapis.com",
        "remote_provisioning.tee.rkp_only=true",
        "ro.crypto.metadata_init_delete_all_keys.enabled=true",
        "ro.hardware.keystore_desede=true",
        "ro.product.brand_for_attestation=Fairphone",
        "ro.product.name_for_attestation=FP6",
        "ro.product.model_for_attestation=Fairphone 6",
        "ro.product.device_for_attestation=FP6",
        "ro.product.manufacturer_for_attestation=Fairphone",
        "keyguard.no_require_sim=true",
        "persist.vendor.data.profile_update=true",
        "audio.timecheck.timeout_duration_ms=8000"
      ]
    },
    {
      "id": "debugfs-restrictions",
      "why": "Debuggable builds restrict debugfs. The platform sets this only for non-user builds.",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "equals": [
        "ro.product.debugfs_restrictions.enabled=true"
      ],
      "variants": [
        "userdebug"
      ]
    },
    {
      "id": "debugfs-restrictions-user",
      "why": "User builds never mount debugfs, so the platform leaves the restriction property out.",
      "type": "properties",
      "file": "VENDOR/build.prop",
      "absent": [
        "ro.product.debugfs_restrictions.enabled"
      ],
      "variants": [
        "user"
      ]
    },
    {
      "id": "stock-properties-settable",
      "why": "vendor_init may set those properties under the platform policy.",
      "type": "text",
      "files": [
        "SYSTEM/etc/selinux/plat_sepolicy.cil"
      ],
      "regex": [
