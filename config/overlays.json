{
  "schema_version": 1,
  "api_level": 37,
  "device": {
    "density_dpi": 480,
    "smallest_width_dp": 372
  },
  "inapplicable_qualifier_tokens": [
    "r(XA|XB|XC)",
    "television|watch|car|desk|appliance|vrheadset",
    "sw([6-9][0-9]{2}|[0-9]{4,})dp"
  ],
  "overlay_roots": [
    {
      "path": "vendor_diamaneos/overlay",
      "role": "product"
    },
    {
      "path": "device_fairphone_FP6/rro",
      "role": "device"
    }
  ],
  "make_roots": [
    "vendor_diamaneos",
    "device_fairphone_FP6"
  ],
  "product_rules": {
    "allowed_types": [
      "style",
      "color",
      "drawable",
      "dimen",
      "font",
      "mipmap",
      "anim"
    ],
    "restricted_prefixes": [
      "config_"
    ],
    "allowed_names": {
      "android": {
        "config_buttonTextAllCaps": "Tally buttons are not in capitals",
        "config_useRoundIcon": "the keycap icon shape replaces round icons",
        "config_icon_mask": "the 22 % keycap icon shape",
        "config_buttonCornerRadius": "Tally radius 8",
        "config_dialogCornerRadius": "Tally radius 20",
        "config_bottomDialogCornerRadius": "Tally radius 20",
        "theming_defaults": "Sodium as the starting colour",
        "config_headlineFontFamily": "Sofia Sans, after the metric gate",
        "config_headlineFontFamilyMedium": "Sofia Sans, after the metric gate",
        "config_bodyFontFamily": "Sofia Sans, after the metric gate",
        "config_bodyFontFamilyMedium": "Sofia Sans, after the metric gate",
        "default_wallpaper": "DiamaneOS default wallpaper",
        "default_lock_wallpaper": "DiamaneOS default lock wallpaper",
        "config_hapticFeedbackCustomizationFile": "product haptic feedback customization, checked against the FP6 vibrator HAL"
      },
      "com.android.documentsui": {
        "force_material3": "Material 3 Files (owner decision 4, 26 September 2026); the trash flow and the new archive code it would also enable stay off through vendor_diamaneos release/ until their security review, tests and threat-model row"
      },
      "com.android.customization.themes": {
        "color_bundles": "the five DiamaneOS colour presets (Sodium, Phosphor, Signal violet, Rose, Lichen) instead of the 17 AOSP ones; an overlay cannot add names, so they reuse the stub keys rainbow1 to rainbow5",
        "color_style_rainbow1": "palette style of a DiamaneOS preset: TONAL_SPOT, an existing ThemeStyle that the DiamaneOS palette refines",
        "color_style_rainbow2": "palette style of a DiamaneOS preset: TONAL_SPOT, an existing ThemeStyle that the DiamaneOS palette refines",
        "color_style_rainbow3": "palette style of a DiamaneOS preset: TONAL_SPOT, an existing ThemeStyle that the DiamaneOS palette refines",
        "color_style_rainbow4": "palette style of a DiamaneOS preset: TONAL_SPOT, an existing ThemeStyle that the DiamaneOS palette refines",
        "color_style_rainbow5": "palette style of a DiamaneOS preset: TONAL_SPOT, an existing ThemeStyle that the DiamaneOS palette refines"
      }
    },
    "allowed_strings": {
      "com.android.settings": {
        "security_settings_fingerprint_v2_enroll_introduction_footer_message_3": "rebrand: AOSP's generic Fingerprint Unlock instead of Pixel Imprint",
        "security_settings_fingerprint_v2_enroll_introduction_footer_message_consent_3": "rebrand: AOSP's generic Fingerprint Unlock instead of Pixel Imprint",
        "duress_pwd_description": "rebrand (UI-02): \"DiamaneOS will remain installed\" instead of GrapheneOS; otherwise unchanged",
        "aep_compat_mode_summary": "rebrand (UI-04): \"DiamaneOS exploit protections\" instead of GrapheneOS; otherwise unchanged",
        "app_play_integrity_top_intro": "rebrand (UI-03): DiamaneOS wording that drops GrapheneOS's untested claims about integrity levels, bans and attestation (approved by the owner, 28 September 2026)"
      },
      "android": {
        "deprecated_abi_message_grapheneos": "rebrand (UI-08): the 32-bit app dialog shows AOSP's own text, deprecated_abi_message, by reference, instead of text naming GrapheneOS and its plans"
      },
      "app.grapheneos.setupwizard": {
        "welcome_to_grapheneos": "rebrand (SW-01): \"Welcome to DiamaneOS\"",
        "grapheneos_desc": "rebrand (SW-01): the DiamaneOS tagline instead of GrapheneOS's (approved by the owner, 28 September 2026)",
        "grapheneos_icon": "rebrand (SW-02): the logo's content description, \"DiamaneOS\""
      },
      "com.android.customization.themes": {
        "bundle_name_rainbow1": "name of the Sodium colour preset",
        "bundle_name_rainbow2": "name of the Phosphor colour preset",
        "bundle_name_rainbow3": "name of the Signal violet colour preset",
        "bundle_name_rainbow4": "name of the Rose colour preset",
        "bundle_name_rainbow5": "name of the Lichen colour preset"
      }
    },
    "denied_names": {
      "com.android.permissioncontroller": {
        "camera_toggle_enable_config": "privacy toggle",
        "mic_toggle_enable_config": "privacy toggle",
        "clipboard_show_access_notifications_config": "access notifications",
        "show_access_notifications_default_config": "access notifications",
        "config_display_show_password_toggle": "password toggle",
        "config_useFocusIndicatorInPermissionDialogBeforeUserSetupComplete": "grant dialog behaviour",
        "config_useMaterial3PermissionGrantDialog": "grant dialog implementation; a grant-UI change with its own tests",
        "config_enableExpressiveDesignInRequestPermissionDialog": "grant dialog implementation; a grant-UI change with its own tests",
        "config_enableExpressiveDesignInEnhancedConfirmationDialog": "confirmation dialog implementation",
        "config_enableExpressiveDesignInSafetyCenter": "not overlayable and no effect"
      }
    },
    "denied_types": {
      "com.android.permissioncontroller": {
        "bool": "role, visibility and behaviour switches stay upstream",
        "string": "help URLs and permission wording stay upstream"
      }
    },
    "denied_patterns": {
      "com.android.systemui": {
        "^ongoing_appops_": "privacy indicators stay as the SystemUI fork sets them",
        "^ongoing_privacy_": "privacy indicators stay as the SystemUI fork sets them",
        "^privacy_": "privacy indicators stay as the SystemUI fork sets them",
        "^tally_": "the Tally shell's tokens and indicator resources (sensor and capture colours, the privacy dot's size and margin, lamps, springs) come from the SystemUI fork and its token library; the lens config is a device value"
      }
    },
    "qualifier_waivers": []
  },
