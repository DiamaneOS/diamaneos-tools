  "sources": [
    {"id": "grapheneos-platform", "description": "GrapheneOS platform release the Android build is based on (authenticated tag).", "url": "https://github.com/GrapheneOS/platform_manifest.git",
     "follow": {"kind": "tags", "pattern": "^([0-9]{10})$"},
     "pin": {"repository": "tools", "file": "config/build-environment.json", "pointer": "/upstream/release_tag"}},
    {"id": "repo-tool", "description": "repo launcher used to sync the platform.", "url": "https://gerrit.googlesource.com/git-repo",
     "follow": {"kind": "tags", "pattern": "^v([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)$"},
     "pin": {"repository": "tools", "file": "config/build-environment.json", "pointer": "/upstream/repo_tool/release_tag"}},
    {"id": "fairphone-manifest", "description": "Fairphone FP6 source release: device configuration and the kernel-platform projects imported into kernel_qcom-6.1.", "url": "https://gerrit-public.fairphone.software/manifest",
     "follow": {"kind": "branch", "ref": "odm/public-build/16/fp6", "newer_branches": "^odm/public-build/([0-9]+)/fp6$"},
     "pin": {"repository": "tools", "file": "config/fp6-sources.json", "pointer": "/inputs/fairphone_manifest/revision_observed"}},
    {"id": "qualcomm-sepolicy-vendor", "description": "Qualcomm vendor SELinux policy the device policy is selected from.", "url": "https://gerrit-public.fairphone.software/device/qcom/sepolicy_vndr",
     "follow": {"kind": "branch", "ref": "odm/rc/target/16/fp6", "newer_branches": "^odm/rc/target/([0-9]+)/fp6$"},
     "pin": {"repository": "device_fairphone_FP6", "file": "sepolicy/provenance.json", "list": "/files", "match": {"project": "qualcomm-sepolicy-vendor"}, "field": "revision"}},
    {"id": "qualcomm-sepolicy", "description": "Qualcomm system/product SELinux policy the device policy is selected from.", "url": "https://gerrit-public.fairphone.software/device/qcom/sepolicy",
     "follow": {"kind": "branch", "ref": "odm/rc/target/16/fp6", "newer_branches": "^odm/rc/target/([0-9]+)/fp6$"},
     "pin": {"repository": "device_fairphone_FP6", "file": "sepolicy/provenance.json", "list": "/files", "match": {"project": "qualcomm-sepolicy"}, "field": "revision"}},
    {"id": "qualcomm-audio-effects", "description": "Qualcomm VoIP pre-processing descriptors and volume listener the device copies unmodified from audio-ar (audio/effects).", "url": "https://git.codelinaro.org/clo/la/platform/hardware/qcom/audio-ar",
