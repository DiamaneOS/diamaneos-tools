  "denied_modules": [
    {
      "modules": [
        "can-bcm.ko",
        "can-dev.ko",
        "can-gw.ko",
        "can-raw.ko",
        "can.ko",
        "slcan.ko",
        "vcan.ko"
      ],
      "reason": "CAN bus protocol and drivers: the FP6 has no CAN hardware, and slcan adds a tty line discipline."
    },
    {
      "modules": [
        "6lowpan.ko",
        "ieee802154.ko",
        "ieee802154_6lowpan.ko",
        "ieee802154_socket.ko",
        "mac802154.ko",
        "nhc_dest.ko",
        "nhc_fragment.ko",
        "nhc_hop.ko",
        "nhc_ipv6.ko",
        "nhc_mobility.ko",
        "nhc_routing.ko",
        "nhc_udp.ko"
      ],
      "reason": "IEEE 802.15.4 and 6LoWPAN: the FP6 has no radio for them."
    },
    {
      "modules": [
        "nfc.ko"
      ],
      "reason": "Kernel NFC socket family: FP6 NFC is the Samsung sec_nfc transport used by the stock HAL, which does not use it and does not import it."
    },
    {
      "modules": [
        "l2tp_core.ko",
        "l2tp_ppp.ko",
        "pptp.ko"
      ],
      "reason": "PPTP and L2TP tunnels: they serve the legacy VPN types, which Android does not have."
    },
    {
      "modules": [
        "gzvm.ko"
      ],
      "reason": "MediaTek GenieZone hypervisor driver: a different SoC family."
    },
    {
      "modules": [
        "kheaders.ko"
      ],
      "reason": "Kernel headers archive for tracing tools: no product use."
    },
    {
      "modules": [
        "bluetooth.ko",
        "btbcm.ko",
        "btqca.ko",
        "btsdio.ko",
        "hci_uart.ko",
        "hidp.ko",
        "rfcomm.ko"
      ],
      "reason": "In-kernel Bluetooth stack: Android's Bluetooth runs through the stock HCI HAL and btpower, which needs only rfkill. The RFCOMM kernel thread is denied its socket bind."
    },
    {
      "modules": [
        "hdmi_dlkm.ko",
        "lt9611uxc.ko",
        "snd-soc-hdmi-codec.ko"
