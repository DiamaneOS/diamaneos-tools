{
  "schema_version": 2,
  "certificate_subject": "/CN=DiamaneOS/",
  "certificate_algorithm": "RSA-4096 with SHA-256",
  "certificate_roles": [
    "bluetooth",
    "gmscompat_lib",
    "media",
    "networkstack",
    "nfc",
    "platform",
    "releasekey",
    "sdk_sandbox",
    "shared"
  ],
  "apk_selectors": {
    "bluetooth": "bluetooth",
    "gmscompat_lib": "gmscompat_lib",
    "media": "media",
    "networkstack": "networkstack",
    "nfc": "nfc",
    "platform": "platform",
    "releasekey": "releasekey",
    "sdk_sandbox": "sdk_sandbox",
    "shared": "shared",
    "testkey": "releasekey",
    "com.android.bluetooth": "bluetooth"
  },
  "apex_container_role": "releasekey",
  "apex_payload_role": "avb",
  "avb_algorithm": "SHA256_RSA4096",
  "factory_algorithm": "Ed25519",
  "factory_namespace": "factory images",
  "record_namespace": "diamaneos-release-record",
  "unknown_role_policy": "reject",
  "presigned_policy": "exact-external-inventory",
  "public_test_key_policy": "reject-in-production"
