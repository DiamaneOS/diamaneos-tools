{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ComponentArtifactClosure",
  "description": "Generated target artifact mapping consumed by the component decision validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_sha256", "stock_build", "region", "artifacts", "component_results"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "model_sha256": {"$ref": "#/definitions/sha256"},
    "stock_build": {"type": "string", "minLength": 1, "maxLength": 100},
    "region": {"enum": ["EU", "US"]},
    "artifacts": {"type": "array", "maxItems": 65535, "items": {"$ref": "#/definitions/artifact"}},
    "component_results": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/definitions/result"}}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+@/-]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "component_id", "source_or_prebuilt", "inventory_ref", "dependencies"],
      "properties": {
        "path": {"$ref": "#/definitions/path"},
        "sha256": {"$ref": "#/definitions/sha256"},
        "component_id": {"$ref": "#/definitions/id"},
        "source_or_prebuilt": {"enum": ["source-built", "prebuilt"]},
        "inventory_ref": {"type": "string", "pattern": "^[a-z_]+:[a-z0-9][a-z0-9.-]*$"},
        "dependencies": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/definitions/path"}}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "presence", "artifact_paths"],
      "properties": {
        "component_id": {"$ref": "#/definitions/id"},
        "presence": {"enum": ["present", "absent", "not-applicable"]},
        "artifact_paths": {"type": "array", "maxItems": 65535, "uniqueItems": true, "items": {"$ref": "#/definitions/path"}}
      }
    }
  }
}
