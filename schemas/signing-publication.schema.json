{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signed publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signed_target_files", "images_archive", "ota", "factory_archive", "factory_signature", "release_record", "release_signature"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "signed_target_files": {"$ref": "#/definitions/path"},
    "images_archive": {"$ref": "#/definitions/path"},
    "factory_archive": {"$ref": "#/definitions/path"},
    "factory_signature": {"$ref": "#/definitions/path"},
    "release_record": {"$ref": "#/definitions/path"},
    "release_signature": {"$ref": "#/definitions/path"},
    "ota": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "source_target_files"],
        "properties": {
          "file": {"$ref": "#/definitions/path"},
          "source_target_files": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/path"}]}
        }
      }
    }
  },
  "definitions": {
    "path": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
