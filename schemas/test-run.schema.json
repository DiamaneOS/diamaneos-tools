{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiamaneOS device test run",
  "description": "A target-bound staged device test result. Raw private evidence is referenced, not embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation", "run_id", "suite", "tool", "candidate", "evidence_kind",
    "target", "conditions", "started_at_utc", "finished_at_utc", "duration_ms",
    "status", "completeness", "expected_case_ids", "selected_case_ids",
    "completed_case_count", "counts", "identity_evidence_refs", "cases",
    "errors", "retry_parent", "rerun_case_ids", "unresolved_checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"const": "device-test-run"},
    "run_id": {"$ref": "#/definitions/run_id"},
    "suite": {"$ref": "#/definitions/suite"},
    "tool": {"$ref": "#/definitions/tool"},
    "candidate": {"$ref": "#/definitions/candidate"},
    "evidence_kind": {"enum": ["real-device", "emulator", "synthetic-fixture", "static-review"]},
    "target": {"$ref": "#/definitions/target"},
    "conditions": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "INCOMPLETE", "HARNESS_ERROR"]},
    "completeness": {"enum": ["COMPLETE", "SELECTED", "INCOMPLETE"]},
    "expected_case_ids": {"$ref": "#/definitions/id_list"},
    "selected_case_ids": {"$ref": "#/definitions/id_list"},
    "completed_case_count": {"type": "integer", "minimum": 0, "maximum": 256},
    "counts": {"$ref": "#/definitions/counts"},
    "identity_evidence_refs": {"$ref": "#/definitions/evidence_refs"},
    "cases": {"type": "array", "maxItems": 256, "items": {"$ref": "#/definitions/case"}},
    "errors": {
      "type": "array", "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "retry_parent": {"oneOf": [{"$ref": "#/definitions/run_id"}, {"type": "null"}]},
    "rerun_case_ids": {"$ref": "#/definitions/id_list"},
    "unresolved_checks": {"$ref": "#/definitions/id_list"}
  },
  "definitions": {
    "run_id": {
      "type": "string", "minLength": 1, "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "case_id": {
      "type": "string", "minLength": 1, "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"
    },
    "id_list": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/definitions/case_id"}
    },
    "evidence_refs": {
      "type": "array", "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_name", "sha256"],
      "properties": {
        "id": {"$ref": "#/definitions/case_id"},
        "source_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "runner_sha256", "adb"],
      "properties": {
        "revision": {"type": "string", "minLength": 1, "maxLength": 64},
        "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adb": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "manifest_name", "manifest_sha256", "reason"],
      "properties": {
        "kind": {"enum": ["installed-device-build", "candidate-manifest"]},
        "manifest_name": {"type": ["string", "null"], "maxLength": 255},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": [
        "role", "model", "device", "build", "incremental", "firmware",
        "build_type", "security_patch", "evidence_label"
      ],
      "properties": {
        "role": {"$ref": "#/definitions/case_id"},
        "model": {"type": "string", "minLength": 1, "maxLength": 500},
        "device": {"type": "string", "minLength": 1, "maxLength": 500},
        "build": {"type": "string", "minLength": 1, "maxLength": 500},
        "incremental": {"type": "string", "minLength": 1, "maxLength": 500},
        "firmware": {"type": "string", "minLength": 1, "maxLength": 2000},
        "build_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "security_patch": {"type": "string", "minLength": 1, "maxLength": 64},
        "evidence_label": {"enum": ["USER_BUILD_EVIDENCE", "USERDEBUG_DIAGNOSTIC_EVIDENCE", "NON_USER_DIAGNOSTIC_EVIDENCE"]}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["BLOCKED", "FAIL", "HARNESS_ERROR", "INCOMPLETE", "NOT_APPLICABLE", "NOT_RUN", "PASS", "SKIP"],
      "properties": {
        "BLOCKED": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "HARNESS_ERROR": {"type": "integer", "minimum": 0},
        "INCOMPLETE": {"type": "integer", "minimum": 0},
        "NOT_APPLICABLE": {"type": "integer", "minimum": 0},
        "NOT_RUN": {"type": "integer", "minimum": 0},
        "PASS": {"type": "integer", "minimum": 0},
        "SKIP": {"type": "integer", "minimum": 0}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": [
        "test_id", "requirement_ids", "stage", "preconditions", "expected",
        "observed", "status", "reason", "build", "firmware", "build_type",
        "evidence_kind", "duration_ms", "redacted_evidence_refs", "raw_evidence_refs"
      ],
      "properties": {
        "test_id": {"$ref": "#/definitions/case_id"},
        "requirement_ids": {"$ref": "#/definitions/id_list"},
        "stage": {"enum": ["inspect", "smoke", "security", "destructive"]},
        "preconditions": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "expected": {"type": "string", "minLength": 1, "maxLength": 500},
        "observed": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {"enum": ["PASS", "FAIL", "SKIP", "BLOCKED", "NOT_RUN", "HARNESS_ERROR", "INCOMPLETE", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "build": {"type": "string", "minLength": 1, "maxLength": 500},
        "firmware": {"type": "string", "minLength": 1, "maxLength": 2000},
        "build_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "evidence_kind": {"enum": ["real-device", "emulator", "synthetic-fixture", "static-review"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "redacted_evidence_refs": {"$ref": "#/definitions/evidence_refs"},
        "raw_evidence_refs": {"$ref": "#/definitions/evidence_refs"}
      }
    }
  }
}
