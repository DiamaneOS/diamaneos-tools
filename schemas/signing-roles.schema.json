{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_subject",
    "certificate_algorithm",
    "certificate_roles",
    "apk_selectors",
    "apex_container_role",
    "apex_payload_role",
    "avb_algorithm",
    "factory_algorithm",
    "factory_namespace",
    "record_namespace",
    "unknown_role_policy",
    "presigned_policy",
    "public_test_key_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "certificate_subject": {
      "const": "/CN=DiamaneOS/"
    },
    "certificate_algorithm": {
      "const": "RSA-4096 with SHA-256"
    },
    "apex_container_role": {
      "const": "releasekey"
    },
    "apex_payload_role": {
      "const": "avb"
    },
    "avb_algorithm": {
      "const": "SHA256_RSA4096"
    },
    "factory_algorithm": {
      "const": "Ed25519"
    },
    "factory_namespace": {
      "const": "factory images"
    },
    "record_namespace": {
      "const": "diamaneos-release-record"
    },
    "unknown_role_policy": {
      "const": "reject"
    },
    "presigned_policy": {
      "const": "exact-external-inventory"
    },
    "public_test_key_policy": {
      "const": "reject-in-production"
    },
    "certificate_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bluetooth",
          "gmscompat_lib",
          "media",
          "networkstack",
          "nfc",
          "platform",
          "releasekey",
          "sdk_sandbox",
          "shared"
        ]
      },
      "minItems": 9,
      "maxItems": 9
    },
    "apk_selectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "bluetooth",
          "gmscompat_lib",
          "media",
          "networkstack",
          "nfc",
          "platform",
          "releasekey",
          "sdk_sandbox",
          "shared"
        ]
      }
    }
  }
}
