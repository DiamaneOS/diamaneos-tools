#!/usr/bin/env python3
"""Host tooling entry point. Dispatch only implemented commands."""
import os
import sys

# Host commands should never modify an immutable deployment checkout merely by
# importing their modules (especially for a promised no-write dry run).
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "src"))
from diamaneos_tools import baseline


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: diamaneos {baseline capture|baseline pilot|baseline boot|baseline connected|baseline camera|baseline idle|baseline protocol validate|build preflight|carrier matrix validate|endpoints validate|rig|test run} [...]")
        print("routes: baseline capture -> read-only collector")
        print("        baseline pilot -> target-bound connected FP6-022 pilot")
        print("        baseline boot -> staged declared FP6-022 restart-time measurement")
        print("        baseline connected -> staged declared FP6-022 connected measurement")
        print("        baseline camera -> staged FP6-022 original-media measurements")
        print("        baseline idle -> staged or unattended verified-VBUS-off FP6-022 idle measurements")
        print("        baseline protocol validate -> strict no-device protocol validation")
        print("        build preflight -> fail-closed pinned build-input verification")
        print("        carrier matrix validate -> strict no-device carrier-plan validation")
        print("        endpoints validate -> read-only contract checks")
        print("        rig -> identity-bound USB power and battery controller")
        print("        test run -> target-bound staged device tests")
        return 0
    if argv[:2] == ["baseline", "capture"]:
        return baseline.main(argv[2:])
    if argv[:2] == ["baseline", "pilot"]:
        from diamaneos_tools import baseline_pilot
        return baseline_pilot.main(argv[2:])
    if argv[:2] == ["baseline", "boot"]:
        from diamaneos_tools import baseline_boot
        return baseline_boot.main(argv[2:])
    if argv[:2] == ["baseline", "connected"]:
        from diamaneos_tools import baseline_connected
        return baseline_connected.main(argv[2:])
    if argv[:2] == ["baseline", "camera"]:
        from diamaneos_tools import baseline_camera
        return baseline_camera.main(argv[2:])
    if argv[:2] == ["baseline", "idle"]:
        from diamaneos_tools import baseline_idle
        return baseline_idle.main(argv[2:])
    if argv[:3] == ["baseline", "protocol", "validate"]:
        from diamaneos_tools import baseline_protocol
        return baseline_protocol.main(argv[3:])
    if argv[:3] == ["carrier", "matrix", "validate"]:
        from diamaneos_tools import carrier_matrix
        return carrier_matrix.main(argv[3:])
    if argv[:2] == ["build", "preflight"]:
        from diamaneos_tools import build
        return build.main(argv[2:])
    if argv[:2] == ["endpoints", "validate"]:
        from diamaneos_tools import endpoints
        return endpoints.main(argv[2:])
    if argv[:1] == ["rig"]:
        from diamaneos_tools import rig
        return rig.main(argv[1:])
    if argv[:2] == ["test", "run"]:
        from diamaneos_tools import test_runner
        return test_runner.main(argv[2:])
    print("unknown command: " + " ".join(argv), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
