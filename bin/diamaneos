#!/usr/bin/env python3
"""Host tooling entry point. Dispatch only implemented commands."""
import os
import sys

# Host commands should never modify an immutable deployment checkout merely by
# importing their modules (especially for a promised no-write dry run).
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "src"))


BUILD_HELP = """usage: diamaneos build {all|sync|vendor|android|package|verify|kernel|preflight|kernel-config|inputs} [CODENAME] [...]
  build all -> sync, vendor, android, package and verify in one workspace
  build vendor CODENAME -> the vendor files of that device, ready for lunch and m
  build sync|vendor|android|package|verify -> the steps of build all, one at a time
  build kernel -> build the kernel from source (for maintainers, the build uses the kernel prebuilts)
  build preflight -> fail-closed pinned build-input verification
  build kernel-config -> read-only generated kernel configuration policy check
  build inputs CODENAME -> install verified generated Android inputs
Options of a step: diamaneos build <step> --help"""


def line_buffered(*streams):
    """Write each line at once, also into a log file, so a build log can be
    followed while it runs and after the build starts again with new tools."""
    for stream in streams:
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(line_buffering=True)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    line_buffered(sys.stdout, sys.stderr)
    if argv[:1] == ['build'] and argv[1:2] in ([], ['-h'], ['--help']):
        print(BUILD_HELP, file=sys.stdout if argv[1:] else sys.stderr)
        return 0 if argv[1:] else 2
    if argv[:1] == ['build'] and argv[1:2] and argv[1] in ('sync', 'kernel', 'vendor', 'android',
                                                          'package', 'verify', 'all'):
        from diamaneos_tools import build_steps
        return build_steps.main(argv[1:])
    if argv[:1] == ['flash-steps']:
        from diamaneos_tools import flash_steps
        return flash_steps.main(argv[1:])
    if argv[:2] == ['images', 'check']:
        from diamaneos_tools import image_profiles
        return image_profiles.main(argv[2:])
    if argv[:2] == ['build', 'inputs']:
        from diamaneos_tools import product_inputs
        return product_inputs.main(argv[2:])
    if argv[:2] == ['kernel', 'publish']:
        from diamaneos_tools import kernel_publish
        return kernel_publish.main(argv[2:])
    if argv[:2] == ['kernel', 'compare']:
        from diamaneos_tools import kernel_compare
        return kernel_compare.main(argv[2:])
    if argv[:1] == ['kernel']:
        from diamaneos_tools import kernel
        return kernel.main(argv[1:])
    if argv[:1] == ['forks']:
        from diamaneos_tools import forks
        return forks.main(argv[1:])
    if argv[:2] == ['fonts', 'check']:
        from diamaneos_tools import fonts
        return fonts.main(argv[2:])
    if argv[:2] == ['overlays', 'check']:
        from diamaneos_tools import overlays
        return overlays.main(argv[2:])
    if argv[:2] == ['strings', 'check']:
        from diamaneos_tools import strings
        return strings.main(argv[2:])
    if argv[:2] == ['vendor', 'extract']:
        from diamaneos_tools import vendor_extract
        return vendor_extract.main(argv[2:])
    if argv[:2] == ['vendor', 'product']:
        from diamaneos_tools import vendor_product
        return vendor_product.main(argv[2:])
    if not argv or argv[0] in ("-h", "--help"):
        print("Build a test image: diamaneos build all [--variant userdebug], then diamaneos flash-steps.")
        print("  build sync|vendor|android|package|verify -> the steps of build all, one at a time")
        print("  build kernel -> build the kernel from source (for maintainers, the build uses the kernel prebuilts)")
        print("  flash-steps -> fastboot commands for a verified test build (never runs fastboot)")
        print("")
        print("usage: diamaneos {build all|build sync|build kernel|build vendor|build android|build package|build verify|flash-steps|build preflight|build kernel-config|signing|attestation-releases|vendor stage|vendor extract|vendor generate|vendor product|kernel prepare|kernel build|kernel publish|build inputs|forks check|forks status|forks update|fonts check|overlays check|strings check} [...]")
        print("routes: build all -> sync, vendor, android, package and verify in one workspace")
        print("        build preflight -> fail-closed pinned build-input verification")
        print("        build kernel-config -> read-only generated kernel configuration policy check")
        print("        fonts check -> product font customization as Android reads it")
        print("        images check -> the image checks of build verify on any image set, also a re-signed one")
        print("        overlays check -> resource overlays against their targets at a release")
        print("        strings check -> string resources: escaping, placeholders, markup and plurals")
        print("        signing -> verified-build signing plans and native publication signature verification")
        print("        attestation-releases -> signed list of each release's attestation values")
        print("        vendor stage|extract|generate CODENAME -> authenticate images or extract selected stock files")
        print("        vendor product CODENAME -> generate the pinned native Android integration\n        kernel prepare|build -> source, compile and package the kernel set\n        kernel publish -> copy a kernel build into a kernel prebuilts checkout (no commit)\n        build inputs CODENAME -> install verified generated Android inputs")
        return 0
    if argv[:2] == ["build", "kernel-config"]:
        from diamaneos_tools import kernel_config
        return kernel_config.main(argv[2:])
    if argv[:2] == ["build", "preflight"]:
        from diamaneos_tools import build
        return build.main(argv[2:])
    if argv[:1] == ["vendor"]:
        from diamaneos_tools import vendor
        return vendor.main(argv[1:])
    if argv[:1] == ["signing"]:
        from diamaneos_tools import signing_verify
        return signing_verify.main(argv[1:])
    if argv[:1] == ["attestation-releases"]:
        from diamaneos_tools import attestation_releases
        return attestation_releases.main(argv[1:])
    print("unknown command: " + " ".join(argv), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
